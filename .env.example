# Copy to .env, keep mode 0600, and replace private placeholders.
# Model names and the OpenAI-compatible connection are local choices.
# Role assignments and thinking effort remain in configs/benchmark.yml.
LLM_URL_TYPE=openai_chat
LLM_LIGHT_MODEL=deepseek-flash
LLM_DEEP_MODEL=deepseek-flash
LLM_BASE_URL=change-me
LLM_API_KEY=change-me

# Provider defaults below are completed in this same file by precheck.sh.
# Provider LLM connections are derived from the generic connection above.
OAMB_PROVIDER_PROJECT=change-me
OAMB_MEM0_SOURCE_CHECKOUT=change-me

OAMB_HINDSIGHT_PORT=18888
OAMB_MEM0_PORT=18889
OAMB_MEM0_INSPECTOR_PORT=16333
OAMB_OPENVIKING_PORT=19330

# Set the URL to reuse a local or paid OpenAI-compatible embedding service.
# The API key is optional and may be omitted. Leave the URL placeholder unchanged for local fallback.
OAMB_EMBEDDING_BASE_URL=change-me
OAMB_EMBEDDING_API_KEY=

OAMB_MEM0_ADMIN_API_KEY=change-me-at-least-32-characters
OAMB_MEM0_JWT_SECRET=change-me-at-least-48-characters
OAMB_MEM0_POSTGRES_PASSWORD=change-me
OAMB_MEM0_INSPECTOR_API_KEY=change-me-at-least-32-characters

OAMB_OPENVIKING_ROOT_API_KEY=change-me-at-least-32-characters
OAMB_OPENVIKING_ACCOUNT_ID=oamb-benchmark
OAMB_OPENVIKING_ADMIN_USER_ID=oamb-admin
