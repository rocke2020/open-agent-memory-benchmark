# Copy to .env.oam, chmod 600, and configure private endpoints/credentials.
# deepseek-flash must resolve to the published deepseek-v4.1-flash model.
LLM_BASE_URL=change-me
LLM_API_KEY=change-me
LLM_LIGHT_MODEL=deepseek-flash
LLM_DEEP_MODEL=deepseek-flash
OAMB_EMBEDDING_BASE_URL=change-me
OAMB_EMBEDDING_API_KEY=
OAMB_EMBEDDING_MODEL=qwen3-embedding:0.6b
