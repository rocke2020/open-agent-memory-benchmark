{
  "$defs": {
    "BudgetScopeKindV2": {
      "enum": [
        "run",
        "phase_review",
        "model_readiness"
      ],
      "title": "BudgetScopeKindV2",
      "type": "string"
    },
    "ResourceBudgetCeiling": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "minLength": 1,
          "title": "Dimension Id",
          "type": "string"
        },
        "maximum": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
          "title": "Maximum",
          "type": "string"
        },
        "schema_name": {
          "const": "resource_budget_ceiling",
          "default": "resource_budget_ceiling",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "dimension_id",
        "maximum",
        "schema_name",
        "schema_version",
        "unit"
      ],
      "title": "ResourceBudgetCeiling",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/budget_reservation_record/v1",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "budget_id": {
      "minLength": 1,
      "title": "Budget Id",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Currency"
    },
    "reservation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reservation Id",
      "type": "string"
    },
    "reserved_at": {
      "format": "date-time",
      "title": "Reserved At",
      "type": "string"
    },
    "reserved_attempts": {
      "exclusiveMinimum": 0,
      "title": "Reserved Attempts",
      "type": "integer"
    },
    "reserved_cost": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reserved Cost"
    },
    "reserved_dispatch_wall_seconds": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
      "title": "Reserved Dispatch Wall Seconds",
      "type": "string"
    },
    "reserved_input_tokens": {
      "minimum": 0,
      "title": "Reserved Input Tokens",
      "type": "integer"
    },
    "reserved_output_tokens": {
      "minimum": 0,
      "title": "Reserved Output Tokens",
      "type": "integer"
    },
    "reserved_provider_units": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
      "title": "Reserved Provider Units",
      "type": "string"
    },
    "reserved_resource_ceilings": {
      "items": {
        "$ref": "#/$defs/ResourceBudgetCeiling"
      },
      "title": "Reserved Resource Ceilings",
      "type": "array"
    },
    "role_binding_id": {
      "minLength": 1,
      "title": "Role Binding Id",
      "type": "string"
    },
    "schema_name": {
      "const": "budget_reservation_record",
      "default": "budget_reservation_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "minLength": 1,
      "title": "Scope Id",
      "type": "string"
    },
    "scope_kind": {
      "$ref": "#/$defs/BudgetScopeKindV2"
    }
  },
  "required": [
    "attempt_id",
    "budget_id",
    "currency",
    "reservation_id",
    "reserved_at",
    "reserved_attempts",
    "reserved_cost",
    "reserved_dispatch_wall_seconds",
    "reserved_input_tokens",
    "reserved_output_tokens",
    "reserved_provider_units",
    "reserved_resource_ceilings",
    "role_binding_id",
    "schema_name",
    "schema_version",
    "scope_id",
    "scope_kind"
  ],
  "title": "budget_reservation_record",
  "type": "object"
}
