{
  "$defs": {
    "SourceEvidenceKind": {
      "enum": [
        "run",
        "external",
        "derivation",
        "provider_service"
      ],
      "title": "SourceEvidenceKind",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/source_evidence_binding/v1",
  "additionalProperties": false,
  "properties": {
    "binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Id",
      "type": "string"
    },
    "schema_name": {
      "const": "source_evidence_binding",
      "default": "source_evidence_binding",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_identity": {
      "minLength": 1,
      "title": "Source Identity",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceEvidenceKind"
    },
    "source_root_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Root Hash",
      "type": "string"
    },
    "source_schema_versions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Source Schema Versions",
      "type": "array"
    },
    "validation_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Result Hash",
      "type": "string"
    }
  },
  "required": [
    "binding_id",
    "schema_name",
    "schema_version",
    "source_identity",
    "source_kind",
    "source_root_hash",
    "source_schema_versions",
    "validation_result_hash"
  ],
  "title": "source_evidence_binding",
  "type": "object"
}
