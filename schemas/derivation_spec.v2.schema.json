{
  "$defs": {
    "ReportIdentitySpecBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "schema_name": {
          "const": "report_identity_spec_binding",
          "default": "report_identity_spec_binding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "spec_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "spec_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Id",
          "type": "string"
        },
        "spec_kind": {
          "enum": [
            "benchmark_report",
            "acceptance_report"
          ],
          "title": "Spec Kind",
          "type": "string"
        },
        "spec_schema_name": {
          "enum": [
            "report_spec",
            "acceptance_report_spec"
          ],
          "title": "Spec Schema Name",
          "type": "string"
        },
        "spec_schema_version": {
          "const": 1,
          "default": 1,
          "title": "Spec Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "binding_id",
        "schema_name",
        "schema_version",
        "spec_hash",
        "spec_id",
        "spec_kind",
        "spec_schema_name"
      ],
      "title": "ReportIdentitySpecBinding",
      "type": "object"
    },
    "SourceEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "schema_name": {
          "const": "source_evidence_binding",
          "default": "source_evidence_binding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_identity": {
          "minLength": 1,
          "title": "Source Identity",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceEvidenceKind"
        },
        "source_root_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Root Hash",
          "type": "string"
        },
        "source_schema_versions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Schema Versions",
          "type": "array"
        },
        "validation_result_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Result Hash",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "schema_name",
        "schema_version",
        "source_identity",
        "source_kind",
        "source_root_hash",
        "source_schema_versions",
        "validation_result_hash"
      ],
      "title": "SourceEvidenceBinding",
      "type": "object"
    },
    "SourceEvidenceKind": {
      "enum": [
        "run",
        "external",
        "derivation",
        "provider_service"
      ],
      "title": "SourceEvidenceKind",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/derivation_spec/v2",
  "additionalProperties": false,
  "properties": {
    "derivation_input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Derivation Input Hash",
      "type": "string"
    },
    "derivation_kind": {
      "minLength": 1,
      "title": "Derivation Kind",
      "type": "string"
    },
    "evidence_validation_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Validation Result Hash",
      "type": "string"
    },
    "ordered_source_bindings": {
      "items": {
        "$ref": "#/$defs/SourceEvidenceBinding"
      },
      "title": "Ordered Source Bindings",
      "type": "array"
    },
    "ordered_source_root_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ordered Source Root Hash",
      "type": "string"
    },
    "reducer_and_renderer_input_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Reducer And Renderer Input Hashes",
      "type": "array"
    },
    "report_identity_spec_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportIdentitySpecBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_name": {
      "const": "derivation_spec",
      "default": "derivation_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "transform_spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transform Spec Hash",
      "type": "string"
    }
  },
  "required": [
    "derivation_input_hash",
    "derivation_kind",
    "evidence_validation_result_hash",
    "ordered_source_bindings",
    "ordered_source_root_hash",
    "reducer_and_renderer_input_hashes",
    "report_identity_spec_binding",
    "schema_name",
    "schema_version",
    "transform_spec_hash"
  ],
  "title": "derivation_spec",
  "type": "object"
}
