{
  "$defs": {
    "ValidationDisposition": {
      "enum": [
        "not_run",
        "validated",
        "invalid"
      ],
      "title": "ValidationDisposition",
      "type": "string"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "remediation_code": {
          "minLength": 1,
          "title": "Remediation Code",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "schema_name": {
          "const": "validation_issue",
          "default": "validation_issue",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/ValidationSeverity"
        }
      },
      "required": [
        "code",
        "evidence_ref",
        "json_pointer",
        "remediation_code",
        "rule_id",
        "schema_name",
        "schema_version",
        "severity"
      ],
      "title": "ValidationIssue",
      "type": "object"
    },
    "ValidationSeverity": {
      "enum": [
        "error",
        "warning"
      ],
      "title": "ValidationSeverity",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/validation_result/v1",
  "additionalProperties": false,
  "properties": {
    "disposition": {
      "$ref": "#/$defs/ValidationDisposition"
    },
    "executed_rule_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Executed Rule Ids",
      "type": "array"
    },
    "failed_rule_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Failed Rule Ids",
      "type": "array"
    },
    "implementation_versions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Implementation Versions",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "missing_rule_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Rule Ids",
      "type": "array"
    },
    "not_applicable_rule_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Not Applicable Rule Ids",
      "type": "array"
    },
    "passed_rule_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Passed Rule Ids",
      "type": "array"
    },
    "required_rule_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Rule Ids",
      "type": "array"
    },
    "schema_name": {
      "const": "validation_result",
      "default": "validation_result",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Hash",
      "type": "string"
    },
    "validation_profile_id": {
      "minLength": 1,
      "title": "Validation Profile Id",
      "type": "string"
    }
  },
  "required": [
    "disposition",
    "executed_rule_ids",
    "failed_rule_ids",
    "implementation_versions",
    "issues",
    "missing_rule_ids",
    "not_applicable_rule_ids",
    "passed_rule_ids",
    "required_rule_ids",
    "schema_name",
    "schema_version",
    "target_hash",
    "validation_profile_id"
  ],
  "title": "validation_result",
  "type": "object"
}
