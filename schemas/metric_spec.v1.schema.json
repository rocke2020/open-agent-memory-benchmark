{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/metric_spec/v1",
  "additionalProperties": false,
  "properties": {
    "answer_set_policy": {
      "minLength": 1,
      "title": "Answer Set Policy",
      "type": "string"
    },
    "compatible_output_contract_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Compatible Output Contract Ids",
      "type": "array"
    },
    "failure_semantics": {
      "enum": [
        "unavailable",
        "terminal_error"
      ],
      "title": "Failure Semantics",
      "type": "string"
    },
    "input_fields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Input Fields",
      "type": "array"
    },
    "judge_prompt_pack_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Judge Prompt Pack Id"
    },
    "metric_id": {
      "minLength": 1,
      "title": "Metric Id",
      "type": "string"
    },
    "normalizer_id": {
      "minLength": 1,
      "title": "Normalizer Id",
      "type": "string"
    },
    "output_contract_id": {
      "minLength": 1,
      "title": "Output Contract Id",
      "type": "string"
    },
    "schema_name": {
      "const": "metric_spec",
      "default": "metric_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scorer_id": {
      "minLength": 1,
      "title": "Scorer Id",
      "type": "string"
    },
    "unjudged_semantics": {
      "enum": [
        "unavailable",
        "not_applicable",
        "unjudged"
      ],
      "title": "Unjudged Semantics",
      "type": "string"
    }
  },
  "required": [
    "answer_set_policy",
    "failure_semantics",
    "input_fields",
    "judge_prompt_pack_id",
    "metric_id",
    "normalizer_id",
    "output_contract_id",
    "schema_name",
    "schema_version",
    "scorer_id",
    "unjudged_semantics"
  ],
  "title": "metric_spec",
  "type": "object"
}
