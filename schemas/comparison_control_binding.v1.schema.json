{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/comparison_control_binding/v1",
  "additionalProperties": false,
  "properties": {
    "control_id": {
      "minLength": 1,
      "title": "Control Id",
      "type": "string"
    },
    "schema_name": {
      "const": "comparison_control_binding",
      "default": "comparison_control_binding",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "value_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Value Hash",
      "type": "string"
    }
  },
  "required": [
    "control_id",
    "schema_name",
    "schema_version",
    "value_hash"
  ],
  "title": "comparison_control_binding",
  "type": "object"
}
