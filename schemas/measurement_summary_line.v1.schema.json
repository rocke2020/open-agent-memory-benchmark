{
  "$defs": {
    "ExactRational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "title": "Numerator",
          "type": "integer"
        },
        "schema_name": {
          "const": "exact_rational",
          "default": "exact_rational",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "denominator",
        "numerator",
        "schema_name",
        "schema_version"
      ],
      "title": "ExactRational",
      "type": "object"
    },
    "ProofStatus": {
      "enum": [
        "measured_complete",
        "measured_partial",
        "unavailable",
        "not_applicable"
      ],
      "title": "ProofStatus",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/measurement_summary_line/v1",
  "additionalProperties": false,
  "properties": {
    "basis": {
      "enum": [
        "raw_resource",
        "actual_supplier_charge",
        "estimate_from_measured_usage",
        "token_count"
      ],
      "title": "Basis",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Currency"
    },
    "dimension_id": {
      "minLength": 1,
      "title": "Dimension Id",
      "type": "string"
    },
    "indexing_view": {
      "enum": [
        "attempted",
        "final_contribution",
        "not_applicable"
      ],
      "title": "Indexing View",
      "type": "string"
    },
    "owner_kind": {
      "enum": [
        "ingestion_plan",
        "case",
        "phase_review",
        "model_readiness",
        "run"
      ],
      "title": "Owner Kind",
      "type": "string"
    },
    "proof_status": {
      "$ref": "#/$defs/ProofStatus"
    },
    "reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "schema_name": {
      "const": "measurement_summary_line",
      "default": "measurement_summary_line",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Source Record Ids",
      "type": "array"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "unit": {
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRational"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "basis",
    "currency",
    "dimension_id",
    "indexing_view",
    "owner_kind",
    "proof_status",
    "reason",
    "schema_name",
    "schema_version",
    "source_record_ids",
    "stage",
    "unit",
    "value"
  ],
  "title": "measurement_summary_line",
  "type": "object"
}
