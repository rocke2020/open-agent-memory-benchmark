{
  "$defs": {
    "ComparabilityStatus": {
      "enum": [
        "comparable",
        "not_comparable",
        "unknown"
      ],
      "title": "ComparabilityStatus",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/execution_environment_binding/v1",
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "minLength": 1,
      "title": "Architecture",
      "type": "string"
    },
    "comparability_status": {
      "$ref": "#/$defs/ComparabilityStatus"
    },
    "cpu_description": {
      "minLength": 1,
      "title": "Cpu Description",
      "type": "string"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Hash",
      "type": "string"
    },
    "memory_bytes": {
      "exclusiveMinimum": 0,
      "title": "Memory Bytes",
      "type": "integer"
    },
    "operating_system": {
      "minLength": 1,
      "title": "Operating System",
      "type": "string"
    },
    "python_version": {
      "minLength": 1,
      "title": "Python Version",
      "type": "string"
    },
    "schema_name": {
      "const": "execution_environment_binding",
      "default": "execution_environment_binding",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "architecture",
    "comparability_status",
    "cpu_description",
    "environment_hash",
    "memory_bytes",
    "operating_system",
    "python_version",
    "schema_name",
    "schema_version"
  ],
  "title": "execution_environment_binding",
  "type": "object"
}
