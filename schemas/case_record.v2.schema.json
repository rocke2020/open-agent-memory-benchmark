{
  "$defs": {
    "CaseEvaluationDisposition": {
      "enum": [
        "not_run",
        "deterministic_evaluated",
        "judged",
        "unjudged"
      ],
      "title": "CaseEvaluationDisposition",
      "type": "string"
    },
    "CaseState": {
      "enum": [
        "pending",
        "retrieving",
        "normalizing",
        "answering",
        "evaluating",
        "sealing",
        "completed",
        "error",
        "unsupported",
        "cancelled",
        "budget_exceeded"
      ],
      "title": "CaseState",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/case_record/v2",
  "additionalProperties": false,
  "properties": {
    "answer_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Answer Raw Ref"
    },
    "attempt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Attempt Ids",
      "type": "array"
    },
    "case_manifest_entry_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Manifest Entry Id",
      "type": "string"
    },
    "case_occurrence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Occurrence Id",
      "type": "string"
    },
    "error_stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Stage"
    },
    "evaluation_disposition": {
      "$ref": "#/$defs/CaseEvaluationDisposition"
    },
    "evaluation_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Evaluation Raw Ref"
    },
    "ingestion_occurrence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingestion Occurrence Id",
      "type": "string"
    },
    "parsed_answer_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parsed Answer Sha256"
    },
    "prompt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prompt Sha256"
    },
    "retrieval_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retrieval Raw Ref"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "case_record",
      "default": "case_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/CaseState"
    }
  },
  "required": [
    "answer_raw_ref",
    "attempt_ids",
    "case_manifest_entry_id",
    "case_occurrence_id",
    "error_stage",
    "evaluation_disposition",
    "evaluation_raw_ref",
    "ingestion_occurrence_id",
    "parsed_answer_sha256",
    "prompt_sha256",
    "retrieval_raw_ref",
    "run_id",
    "schema_name",
    "schema_version",
    "state"
  ],
  "title": "case_record",
  "type": "object"
}
