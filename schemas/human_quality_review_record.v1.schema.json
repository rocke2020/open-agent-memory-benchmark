{
  "$defs": {
    "SignatureVerificationRecord": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key Binding Id",
          "type": "string"
        },
        "public_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Public Key Sha256",
          "type": "string"
        },
        "schema_name": {
          "const": "signature_verification_record",
          "default": "signature_verification_record",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature Sha256",
          "type": "string"
        },
        "signed_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signed Payload Sha256",
          "type": "string"
        },
        "trusted_key_fingerprint": {
          "minLength": 1,
          "title": "Trusted Key Fingerprint",
          "type": "string"
        },
        "verification_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Id",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "key_binding_id",
        "public_key_sha256",
        "schema_name",
        "schema_version",
        "signature_sha256",
        "signed_payload_sha256",
        "trusted_key_fingerprint",
        "verification_id",
        "verified_at"
      ],
      "title": "SignatureVerificationRecord",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/human_quality_review_record/v1",
  "additionalProperties": false,
  "properties": {
    "ai_review_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ai Review Record Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Hash",
      "type": "string"
    },
    "decision_nonce": {
      "minLength": 1,
      "title": "Decision Nonce",
      "type": "string"
    },
    "evidence_references": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "finding_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Finding Codes",
      "type": "array"
    },
    "human_review_record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Human Review Record Id",
      "type": "string"
    },
    "review_bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Bundle Hash",
      "type": "string"
    },
    "reviewer_label": {
      "minLength": 1,
      "title": "Reviewer Label",
      "type": "string"
    },
    "schema_name": {
      "const": "human_quality_review_record",
      "default": "human_quality_review_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "signature_verification": {
      "$ref": "#/$defs/SignatureVerificationRecord"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "trusted_key_fingerprint": {
      "minLength": 1,
      "title": "Trusted Key Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "ai_review_record_hash",
    "created_at",
    "decision_hash",
    "decision_nonce",
    "evidence_references",
    "finding_codes",
    "human_review_record_id",
    "review_bundle_hash",
    "reviewer_label",
    "schema_name",
    "schema_version",
    "signature_verification",
    "status",
    "trusted_key_fingerprint"
  ],
  "title": "human_quality_review_record",
  "type": "object"
}
