{
  "$defs": {
    "RuntimeAttestationStatus": {
      "enum": [
        "runtime_verified",
        "build_provenance_verified",
        "unattested",
        "unsupported"
      ],
      "title": "RuntimeAttestationStatus",
      "type": "string"
    },
    "SourceEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "schema_name": {
          "const": "source_evidence_binding",
          "default": "source_evidence_binding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_identity": {
          "minLength": 1,
          "title": "Source Identity",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceEvidenceKind"
        },
        "source_root_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Root Hash",
          "type": "string"
        },
        "source_schema_versions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Schema Versions",
          "type": "array"
        },
        "validation_result_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Result Hash",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "schema_name",
        "schema_version",
        "source_identity",
        "source_kind",
        "source_root_hash",
        "source_schema_versions",
        "validation_result_hash"
      ],
      "title": "SourceEvidenceBinding",
      "type": "object"
    },
    "SourceEvidenceKind": {
      "enum": [
        "run",
        "external",
        "derivation",
        "provider_service"
      ],
      "title": "SourceEvidenceKind",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/memory_system_runtime_binding/v2",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "minLength": 1,
      "title": "Api Version",
      "type": "string"
    },
    "artifact_kind": {
      "minLength": 1,
      "title": "Artifact Kind",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "attestation_method": {
      "minLength": 1,
      "title": "Attestation Method",
      "type": "string"
    },
    "attestation_status": {
      "$ref": "#/$defs/RuntimeAttestationStatus"
    },
    "deployment_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deployment Configuration Sha256",
      "type": "string"
    },
    "distance_metric": {
      "minLength": 1,
      "title": "Distance Metric",
      "type": "string"
    },
    "distribution_channel": {
      "minLength": 1,
      "title": "Distribution Channel",
      "type": "string"
    },
    "edition": {
      "minLength": 1,
      "title": "Edition",
      "type": "string"
    },
    "endpoint_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Endpoint Fingerprint",
      "type": "string"
    },
    "index_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Index Configuration Sha256",
      "type": "string"
    },
    "memory_system_id": {
      "minLength": 1,
      "title": "Memory System Id",
      "type": "string"
    },
    "model_readiness_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceEvidenceBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_readiness_required": {
      "title": "Model Readiness Required",
      "type": "boolean"
    },
    "model_role_binding_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Model Role Binding Ids",
      "type": "array"
    },
    "native_feature_flags_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Native Feature Flags Fingerprint",
      "type": "string"
    },
    "native_reranking_status": {
      "const": "disabled",
      "title": "Native Reranking Status",
      "type": "string"
    },
    "provider_profile_id": {
      "minLength": 1,
      "title": "Provider Profile Id",
      "type": "string"
    },
    "provider_project_id": {
      "minLength": 1,
      "title": "Provider Project Id",
      "type": "string"
    },
    "raw_proof_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Raw Proof Refs",
      "type": "array"
    },
    "release_version": {
      "minLength": 1,
      "title": "Release Version",
      "type": "string"
    },
    "runtime_binding_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Binding Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "memory_system_runtime_binding",
      "default": "memory_system_runtime_binding",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_revision": {
      "minLength": 1,
      "title": "Schema Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "storage_engine": {
      "minLength": 1,
      "title": "Storage Engine",
      "type": "string"
    },
    "storage_engine_version": {
      "minLength": 1,
      "title": "Storage Engine Version",
      "type": "string"
    },
    "vector_dimension": {
      "exclusiveMinimum": 0,
      "title": "Vector Dimension",
      "type": "integer"
    },
    "vector_index_type": {
      "minLength": 1,
      "title": "Vector Index Type",
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "artifact_kind",
    "artifact_sha256",
    "attestation_method",
    "attestation_status",
    "deployment_configuration_sha256",
    "distance_metric",
    "distribution_channel",
    "edition",
    "endpoint_fingerprint",
    "index_configuration_sha256",
    "memory_system_id",
    "model_readiness_evidence",
    "model_readiness_required",
    "model_role_binding_ids",
    "native_feature_flags_fingerprint",
    "native_reranking_status",
    "provider_profile_id",
    "provider_project_id",
    "raw_proof_refs",
    "release_version",
    "runtime_binding_hash",
    "schema_name",
    "schema_revision",
    "schema_version",
    "source_revision",
    "storage_engine",
    "storage_engine_version",
    "vector_dimension",
    "vector_index_type"
  ],
  "title": "memory_system_runtime_binding",
  "type": "object"
}
