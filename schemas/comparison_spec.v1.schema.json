{
  "$defs": {
    "ComparisonCostControl": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "raw_resource",
            "actual_supplier_charge",
            "estimate_from_measured_usage"
          ],
          "title": "Basis",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "dimension_id": {
          "minLength": 1,
          "title": "Dimension Id",
          "type": "string"
        },
        "environment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Hash",
          "type": "string"
        },
        "fx_policy_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fx Policy Hash"
        },
        "measurement_spec_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Measurement Spec Hash",
          "type": "string"
        },
        "price_policy_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price Policy Hash"
        },
        "schema_name": {
          "const": "comparison_cost_control",
          "default": "comparison_cost_control",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/ComparisonCostView"
        }
      },
      "required": [
        "basis",
        "currency",
        "dimension_id",
        "environment_hash",
        "fx_policy_hash",
        "measurement_spec_hash",
        "price_policy_hash",
        "schema_name",
        "schema_version",
        "unit",
        "view"
      ],
      "title": "ComparisonCostControl",
      "type": "object"
    },
    "ComparisonCostView": {
      "enum": [
        "none",
        "raw_resource",
        "actual_charge",
        "declared_rate_estimate"
      ],
      "title": "ComparisonCostView",
      "type": "string"
    },
    "ComparisonPairBinding": {
      "additionalProperties": false,
      "properties": {
        "case_manifest_entry_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Manifest Entry Id",
          "type": "string"
        },
        "left_case_occurrence_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Left Case Occurrence Id",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "pair_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pair Id",
          "type": "string"
        },
        "right_case_occurrence_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Right Case Occurrence Id",
          "type": "string"
        },
        "schema_name": {
          "const": "comparison_pair_binding",
          "default": "comparison_pair_binding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "case_manifest_entry_id",
        "left_case_occurrence_id",
        "metric_id",
        "pair_id",
        "right_case_occurrence_id",
        "schema_name",
        "schema_version"
      ],
      "title": "ComparisonPairBinding",
      "type": "object"
    },
    "ComparisonWinnerReducer": {
      "additionalProperties": false,
      "properties": {
        "aggregate_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Aggregate Contract Hash",
          "type": "string"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "reducer_id": {
          "minLength": 1,
          "title": "Reducer Id",
          "type": "string"
        },
        "reducer_version": {
          "exclusiveMinimum": 0,
          "title": "Reducer Version",
          "type": "integer"
        },
        "schema_name": {
          "const": "comparison_winner_reducer",
          "default": "comparison_winner_reducer",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "aggregate_contract_hash",
        "denominator",
        "metric_id",
        "reducer_id",
        "reducer_version",
        "schema_name",
        "schema_version"
      ],
      "title": "ComparisonWinnerReducer",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/comparison_spec/v1",
  "additionalProperties": false,
  "properties": {
    "comparison_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Comparison Policy Hash",
      "type": "string"
    },
    "comparison_spec_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Comparison Spec Id",
      "type": "string"
    },
    "cost_control": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComparisonCostControl"
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_view": {
      "$ref": "#/$defs/ComparisonCostView"
    },
    "left_run_id": {
      "minLength": 1,
      "title": "Left Run Id",
      "type": "string"
    },
    "ordered_pair_bindings": {
      "items": {
        "$ref": "#/$defs/ComparisonPairBinding"
      },
      "title": "Ordered Pair Bindings",
      "type": "array"
    },
    "required_control_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Control Ids",
      "type": "array"
    },
    "right_run_id": {
      "minLength": 1,
      "title": "Right Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "comparison_spec",
      "default": "comparison_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "winner_reducer": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComparisonWinnerReducer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "comparison_policy_hash",
    "comparison_spec_id",
    "cost_control",
    "cost_view",
    "left_run_id",
    "ordered_pair_bindings",
    "required_control_ids",
    "right_run_id",
    "schema_name",
    "schema_version",
    "winner_reducer"
  ],
  "title": "comparison_spec",
  "type": "object"
}
