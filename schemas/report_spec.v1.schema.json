{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/report_spec/v1",
  "additionalProperties": false,
  "properties": {
    "asset_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Asset Hashes",
      "type": "array"
    },
    "audience": {
      "enum": [
        "local",
        "public"
      ],
      "title": "Audience",
      "type": "string"
    },
    "browser_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Browser Contract Hash",
      "type": "string"
    },
    "display_field_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Display Field Ids",
      "type": "array"
    },
    "export_profile_selector_id": {
      "minLength": 1,
      "title": "Export Profile Selector Id",
      "type": "string"
    },
    "export_profile_selector_version": {
      "exclusiveMinimum": 0,
      "title": "Export Profile Selector Version",
      "type": "integer"
    },
    "performance_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Performance Contract Hash",
      "type": "string"
    },
    "preview_max_field_bytes": {
      "exclusiveMinimum": 0,
      "title": "Preview Max Field Bytes",
      "type": "integer"
    },
    "preview_total_bytes": {
      "exclusiveMinimum": 0,
      "title": "Preview Total Bytes",
      "type": "integer"
    },
    "renderer_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Renderer Hash",
      "type": "string"
    },
    "report_kind": {
      "enum": [
        "run",
        "comparison",
        "release"
      ],
      "title": "Report Kind",
      "type": "string"
    },
    "report_spec_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Spec Id",
      "type": "string"
    },
    "schema_name": {
      "const": "report_spec",
      "default": "report_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "asset_hashes",
    "audience",
    "browser_contract_hash",
    "display_field_ids",
    "export_profile_selector_id",
    "export_profile_selector_version",
    "performance_contract_hash",
    "preview_max_field_bytes",
    "preview_total_bytes",
    "renderer_hash",
    "report_kind",
    "report_spec_id",
    "schema_name",
    "schema_version"
  ],
  "title": "report_spec",
  "type": "object"
}
