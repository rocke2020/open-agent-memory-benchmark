{
  "$defs": {
    "DatasetFile": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_name": {
          "const": "dataset_file",
          "default": "dataset_file",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "byte_count",
        "license_id",
        "relative_path",
        "schema_name",
        "schema_version",
        "sha256"
      ],
      "title": "DatasetFile",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/dataset_manifest/v1",
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "payload_policy": {
      "minLength": 1,
      "title": "Payload Policy",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "schema_name": {
      "const": "dataset_manifest",
      "default": "dataset_manifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_files": {
      "items": {
        "$ref": "#/$defs/DatasetFile"
      },
      "title": "Source Files",
      "type": "array"
    },
    "split": {
      "minLength": 1,
      "title": "Split",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "manifest_hash",
    "payload_policy",
    "revision",
    "schema_name",
    "schema_version",
    "source_files",
    "split"
  ],
  "title": "dataset_manifest",
  "type": "object"
}
