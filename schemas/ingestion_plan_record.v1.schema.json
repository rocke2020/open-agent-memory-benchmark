{
  "$defs": {
    "IngestionPlanState": {
      "enum": [
        "pending",
        "scope_allocated",
        "ingesting",
        "waiting_ready",
        "ready",
        "sealed",
        "error",
        "unsupported",
        "cancelled",
        "budget_exceeded",
        "interrupted_unknown_outcome"
      ],
      "title": "IngestionPlanState",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/ingestion_plan_record/v1",
  "additionalProperties": false,
  "properties": {
    "accepted_source_count": {
      "minimum": 0,
      "title": "Accepted Source Count",
      "type": "integer"
    },
    "attempt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Attempt Ids",
      "type": "array"
    },
    "cost_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Cost Record Ids",
      "type": "array"
    },
    "failed_source_count": {
      "minimum": 0,
      "title": "Failed Source Count",
      "type": "integer"
    },
    "ingestion_occurrence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingestion Occurrence Id",
      "type": "string"
    },
    "ingestion_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingestion Plan Id",
      "type": "string"
    },
    "intended_source_count": {
      "minimum": 0,
      "title": "Intended Source Count",
      "type": "integer"
    },
    "memory_system_id": {
      "minLength": 1,
      "title": "Memory System Id",
      "type": "string"
    },
    "ordered_case_occurrence_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Case Occurrence Ids",
      "type": "array"
    },
    "ordered_member_context_manifest_entry_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Member Context Manifest Entry Ids",
      "type": "array"
    },
    "readiness_evidence_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Readiness Evidence Refs",
      "type": "array"
    },
    "resource_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Resource Record Ids",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "ingestion_plan_record",
      "default": "ingestion_plan_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/IngestionPlanState"
    },
    "usage_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Usage Record Ids",
      "type": "array"
    }
  },
  "required": [
    "accepted_source_count",
    "attempt_ids",
    "cost_record_ids",
    "failed_source_count",
    "ingestion_occurrence_id",
    "ingestion_plan_id",
    "intended_source_count",
    "memory_system_id",
    "ordered_case_occurrence_ids",
    "ordered_member_context_manifest_entry_ids",
    "readiness_evidence_refs",
    "resource_record_ids",
    "run_id",
    "schema_name",
    "schema_version",
    "state",
    "usage_record_ids"
  ],
  "title": "ingestion_plan_record",
  "type": "object"
}
