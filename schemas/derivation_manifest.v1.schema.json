{
  "$defs": {
    "CapsuleManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "minLength": 1,
          "title": "Record Kind",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_name": {
          "const": "capsule_manifest_entry",
          "default": "capsule_manifest_entry",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_kind",
        "relative_path",
        "schema_name",
        "schema_version",
        "sha256"
      ],
      "title": "CapsuleManifestEntry",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/derivation_manifest/v1",
  "additionalProperties": false,
  "properties": {
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "committed_entries": {
      "items": {
        "$ref": "#/$defs/CapsuleManifestEntry"
      },
      "title": "Committed Entries",
      "type": "array"
    },
    "derivation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Derivation Id",
      "type": "string"
    },
    "derivation_spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Derivation Spec Hash",
      "type": "string"
    },
    "evidence_validation_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Validation Result Hash",
      "type": "string"
    },
    "export_validation_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Export Validation Result Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "derivation_manifest",
      "default": "derivation_manifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "committed_at",
    "committed_entries",
    "derivation_id",
    "derivation_spec_hash",
    "evidence_validation_result_hash",
    "export_validation_result_hash",
    "schema_name",
    "schema_version"
  ],
  "title": "derivation_manifest",
  "type": "object"
}
