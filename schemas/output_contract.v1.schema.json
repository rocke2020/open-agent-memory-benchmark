{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/output_contract/v1",
  "additionalProperties": false,
  "properties": {
    "accepted_finish_dispositions": {
      "items": {
        "enum": [
          "normal_stop",
          "length_limit",
          "content_filtered",
          "tool_call",
          "missing_finish_reason",
          "cancelled",
          "incomplete_stream",
          "transport_error"
        ],
        "type": "string"
      },
      "title": "Accepted Finish Dispositions",
      "type": "array"
    },
    "max_output_tokens": {
      "exclusiveMinimum": 0,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "output_contract_id": {
      "minLength": 1,
      "title": "Output Contract Id",
      "type": "string"
    },
    "parse_failure_policy": {
      "enum": [
        "terminal_error",
        "unjudged"
      ],
      "title": "Parse Failure Policy",
      "type": "string"
    },
    "parser_id": {
      "minLength": 1,
      "title": "Parser Id",
      "type": "string"
    },
    "representation": {
      "enum": [
        "text",
        "boolean",
        "ranked_text_list"
      ],
      "title": "Representation",
      "type": "string"
    },
    "required_candidate_count": {
      "exclusiveMinimum": 0,
      "title": "Required Candidate Count",
      "type": "integer"
    },
    "schema_name": {
      "const": "output_contract",
      "default": "output_contract",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "accepted_finish_dispositions",
    "max_output_tokens",
    "output_contract_id",
    "parse_failure_policy",
    "parser_id",
    "representation",
    "required_candidate_count",
    "schema_name",
    "schema_version"
  ],
  "title": "output_contract",
  "type": "object"
}
