{
  "$defs": {
    "ProofStatus": {
      "enum": [
        "measured_complete",
        "measured_partial",
        "unavailable",
        "not_applicable"
      ],
      "title": "ProofStatus",
      "type": "string"
    },
    "TokenDomain": {
      "enum": [
        "local_context_view",
        "external_llm"
      ],
      "title": "TokenDomain",
      "type": "string"
    },
    "TokenMeasurementSource": {
      "enum": [
        "local_tokenizer",
        "supplier_response"
      ],
      "title": "TokenMeasurementSource",
      "type": "string"
    },
    "TokenStageV2": {
      "enum": [
        "memory_ingest",
        "memory_query",
        "context_view",
        "answer",
        "judge",
        "quality_review",
        "model_readiness"
      ],
      "title": "TokenStageV2",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/token_usage_record/v2",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "context_view_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Context View Tokens"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Tokens"
    },
    "measurement_source": {
      "$ref": "#/$defs/TokenMeasurementSource"
    },
    "operation_kind": {
      "minLength": 1,
      "title": "Operation Kind",
      "type": "string"
    },
    "parent_id": {
      "minLength": 1,
      "title": "Parent Id",
      "type": "string"
    },
    "parent_kind": {
      "enum": [
        "ingestion_plan",
        "case",
        "phase_review",
        "model_readiness"
      ],
      "title": "Parent Kind",
      "type": "string"
    },
    "proof_status": {
      "$ref": "#/$defs/ProofStatus"
    },
    "raw_response_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Response Ref"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "schema_name": {
      "const": "token_usage_record",
      "default": "token_usage_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/TokenStageV2"
    },
    "supplier_reported_total_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supplier Reported Total Tokens"
    },
    "token_domain": {
      "$ref": "#/$defs/TokenDomain"
    },
    "usage_record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Usage Record Id",
      "type": "string"
    },
    "visible_output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visible Output Tokens"
    }
  },
  "required": [
    "attempt_id",
    "context_view_tokens",
    "input_tokens",
    "measurement_source",
    "operation_kind",
    "parent_id",
    "parent_kind",
    "proof_status",
    "raw_response_ref",
    "reason",
    "schema_name",
    "schema_version",
    "stage",
    "supplier_reported_total_tokens",
    "token_domain",
    "usage_record_id",
    "visible_output_tokens"
  ],
  "title": "token_usage_record",
  "type": "object"
}
