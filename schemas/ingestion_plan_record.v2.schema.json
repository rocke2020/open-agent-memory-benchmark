{
  "$defs": {
    "IngestionPlanState": {
      "enum": [
        "pending",
        "scope_allocated",
        "ingesting",
        "waiting_ready",
        "ready",
        "sealed",
        "error",
        "unsupported",
        "cancelled",
        "budget_exceeded",
        "interrupted_unknown_outcome"
      ],
      "title": "IngestionPlanState",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/ingestion_plan_record/v2",
  "additionalProperties": false,
  "properties": {
    "accepted_source_unit_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Accepted Source Unit Ids",
      "type": "array"
    },
    "adapter_profile_id": {
      "minLength": 1,
      "title": "Adapter Profile Id",
      "type": "string"
    },
    "attempt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Attempt Ids",
      "type": "array"
    },
    "cost_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Cost Record Ids",
      "type": "array"
    },
    "ingestion_occurrence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingestion Occurrence Id",
      "type": "string"
    },
    "ingestion_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingestion Plan Id",
      "type": "string"
    },
    "inventory_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inventory Raw Ref"
    },
    "memory_system_id": {
      "minLength": 1,
      "title": "Memory System Id",
      "type": "string"
    },
    "ordered_case_occurrence_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Case Occurrence Ids",
      "type": "array"
    },
    "ordered_dispatch_attempt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Dispatch Attempt Ids",
      "type": "array"
    },
    "ordered_dispatch_source_unit_ids": {
      "items": {
        "items": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "type": "array"
      },
      "title": "Ordered Dispatch Source Unit Ids",
      "type": "array"
    },
    "ordered_member_context_manifest_entry_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Member Context Manifest Entry Ids",
      "type": "array"
    },
    "ordered_source_unit_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Source Unit Ids",
      "type": "array"
    },
    "projected_source_unit_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Projected Source Unit Ids",
      "type": "array"
    },
    "projection_raw_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Projection Raw Refs",
      "type": "array"
    },
    "protected_state_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Protected State Sha256"
    },
    "readiness_evidence_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Readiness Evidence Refs",
      "type": "array"
    },
    "rejected_source_unit_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Rejected Source Unit Ids",
      "type": "array"
    },
    "resource_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Resource Record Ids",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "runtime_binding_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Binding Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "ingestion_plan_record",
      "default": "ingestion_plan_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scope Id"
    },
    "scope_raw_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Scope Raw Refs",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/IngestionPlanState"
    },
    "usage_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Usage Record Ids",
      "type": "array"
    }
  },
  "required": [
    "accepted_source_unit_ids",
    "adapter_profile_id",
    "attempt_ids",
    "cost_record_ids",
    "ingestion_occurrence_id",
    "ingestion_plan_id",
    "inventory_raw_ref",
    "memory_system_id",
    "ordered_case_occurrence_ids",
    "ordered_dispatch_attempt_ids",
    "ordered_dispatch_source_unit_ids",
    "ordered_member_context_manifest_entry_ids",
    "ordered_source_unit_ids",
    "projected_source_unit_ids",
    "projection_raw_refs",
    "protected_state_sha256",
    "readiness_evidence_refs",
    "rejected_source_unit_ids",
    "resource_record_ids",
    "run_id",
    "runtime_binding_hash",
    "schema_name",
    "schema_version",
    "scope_id",
    "scope_raw_refs",
    "state",
    "usage_record_ids"
  ],
  "title": "ingestion_plan_record",
  "type": "object"
}
