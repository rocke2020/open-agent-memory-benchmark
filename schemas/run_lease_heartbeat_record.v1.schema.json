{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/run_lease_heartbeat_record/v1",
  "additionalProperties": false,
  "properties": {
    "heartbeat_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Heartbeat Record Hash",
      "type": "string"
    },
    "heartbeat_sequence": {
      "exclusiveMinimum": 0,
      "title": "Heartbeat Sequence",
      "type": "integer"
    },
    "lease_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Lease Record Hash",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "predecessor_heartbeat_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Predecessor Heartbeat Hash"
    },
    "schema_name": {
      "const": "run_lease_heartbeat_record",
      "default": "run_lease_heartbeat_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "heartbeat_record_hash",
    "heartbeat_sequence",
    "lease_record_hash",
    "observed_at",
    "predecessor_heartbeat_hash",
    "schema_name",
    "schema_version"
  ],
  "title": "run_lease_heartbeat_record",
  "type": "object"
}
