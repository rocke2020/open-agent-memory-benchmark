{
  "$defs": {
    "ModelReadinessOccurrenceState": {
      "enum": [
        "planned",
        "budget_reserved",
        "running",
        "sealed",
        "error",
        "cancelled",
        "budget_exceeded",
        "interrupted_unknown_outcome"
      ],
      "title": "ModelReadinessOccurrenceState",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/model_readiness_occurrence_record/v1",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "minLength": 1,
      "title": "Approval Id",
      "type": "string"
    },
    "attempt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Attempt Ids",
      "type": "array"
    },
    "budget_id": {
      "minLength": 1,
      "title": "Budget Id",
      "type": "string"
    },
    "cost_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Cost Record Ids",
      "type": "array"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ended At"
    },
    "occurrence_id": {
      "minLength": 1,
      "title": "Occurrence Id",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "provider_profile_id": {
      "minLength": 1,
      "title": "Provider Profile Id",
      "type": "string"
    },
    "provider_project_id": {
      "minLength": 1,
      "title": "Provider Project Id",
      "type": "string"
    },
    "provider_runtime_profile_attestation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Runtime Profile Attestation Hash",
      "type": "string"
    },
    "resource_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Resource Record Ids",
      "type": "array"
    },
    "role_binding_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Role Binding Ids",
      "type": "array"
    },
    "schema_name": {
      "const": "model_readiness_occurrence_record",
      "default": "model_readiness_occurrence_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "state": {
      "$ref": "#/$defs/ModelReadinessOccurrenceState"
    },
    "usage_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Usage Record Ids",
      "type": "array"
    }
  },
  "required": [
    "approval_id",
    "attempt_ids",
    "budget_id",
    "cost_record_ids",
    "ended_at",
    "occurrence_id",
    "provider",
    "provider_profile_id",
    "provider_project_id",
    "provider_runtime_profile_attestation_hash",
    "resource_record_ids",
    "role_binding_ids",
    "schema_name",
    "schema_version",
    "started_at",
    "state",
    "usage_record_ids"
  ],
  "title": "model_readiness_occurrence_record",
  "type": "object"
}
