{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/run_spec/v1",
  "additionalProperties": false,
  "properties": {
    "budget_id": {
      "minLength": 1,
      "title": "Budget Id",
      "type": "string"
    },
    "case_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Manifest Hash",
      "type": "string"
    },
    "code_revision": {
      "minLength": 1,
      "title": "Code Revision",
      "type": "string"
    },
    "dataset_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Manifest Hash",
      "type": "string"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Hash",
      "type": "string"
    },
    "memory_system_id": {
      "minLength": 1,
      "title": "Memory System Id",
      "type": "string"
    },
    "model_role_binding_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Model Role Binding Ids",
      "type": "array"
    },
    "normalizer_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalizer Fingerprint",
      "type": "string"
    },
    "protocol_id": {
      "minLength": 1,
      "title": "Protocol Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "runtime_binding_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Binding Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "run_spec",
      "default": "run_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workload_id": {
      "minLength": 1,
      "title": "Workload Id",
      "type": "string"
    }
  },
  "required": [
    "budget_id",
    "case_manifest_hash",
    "code_revision",
    "dataset_manifest_hash",
    "environment_hash",
    "memory_system_id",
    "model_role_binding_ids",
    "normalizer_fingerprint",
    "protocol_id",
    "run_id",
    "runtime_binding_hash",
    "schema_name",
    "schema_version",
    "workload_id"
  ],
  "title": "run_spec",
  "type": "object"
}
