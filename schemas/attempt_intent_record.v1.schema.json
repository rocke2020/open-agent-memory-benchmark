{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/attempt_intent_record/v1",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "claim_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Claim Id",
      "type": "string"
    },
    "idempotency_key_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Idempotency Key Hash"
    },
    "parent_id": {
      "minLength": 1,
      "title": "Parent Id",
      "type": "string"
    },
    "parent_kind": {
      "enum": [
        "ingestion_plan",
        "case",
        "phase_review",
        "model_readiness"
      ],
      "title": "Parent Kind",
      "type": "string"
    },
    "reconciliation_capability": {
      "enum": [
        "none",
        "idempotency_key",
        "receipt_lookup"
      ],
      "title": "Reconciliation Capability",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "reservation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reservation Id",
      "type": "string"
    },
    "role_binding_id": {
      "minLength": 1,
      "title": "Role Binding Id",
      "type": "string"
    },
    "schema_name": {
      "const": "attempt_intent_record",
      "default": "attempt_intent_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sealed_at": {
      "format": "date-time",
      "title": "Sealed At",
      "type": "string"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "claim_id",
    "idempotency_key_hash",
    "parent_id",
    "parent_kind",
    "reconciliation_capability",
    "request_fingerprint",
    "reservation_id",
    "role_binding_id",
    "schema_name",
    "schema_version",
    "sealed_at",
    "stage"
  ],
  "title": "attempt_intent_record",
  "type": "object"
}
