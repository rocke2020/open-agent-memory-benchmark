{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/ingestion_plan_manifest/v1",
  "additionalProperties": false,
  "properties": {
    "ingestion_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingestion Payload Hash",
      "type": "string"
    },
    "ingestion_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingestion Plan Id",
      "type": "string"
    },
    "ordered_case_manifest_entry_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Case Manifest Entry Ids",
      "type": "array"
    },
    "ordered_member_context_manifest_entry_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Member Context Manifest Entry Ids",
      "type": "array"
    },
    "ordered_source_unit_bytes_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Source Unit Bytes Sha256",
      "type": "array"
    },
    "plan_manifest_entry_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Manifest Entry Id",
      "type": "string"
    },
    "schema_name": {
      "const": "ingestion_plan_manifest",
      "default": "ingestion_plan_manifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workload_id": {
      "minLength": 1,
      "title": "Workload Id",
      "type": "string"
    }
  },
  "required": [
    "ingestion_payload_hash",
    "ingestion_plan_id",
    "ordered_case_manifest_entry_ids",
    "ordered_member_context_manifest_entry_ids",
    "ordered_source_unit_bytes_sha256",
    "plan_manifest_entry_id",
    "schema_name",
    "schema_version",
    "workload_id"
  ],
  "title": "ingestion_plan_manifest",
  "type": "object"
}
