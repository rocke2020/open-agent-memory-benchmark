{
  "$defs": {
    "AttemptOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "budget_exceeded",
        "unknown_outcome"
      ],
      "title": "AttemptOutcome",
      "type": "string"
    },
    "IndexContribution": {
      "enum": [
        "final",
        "superseded",
        "none",
        "not_applicable"
      ],
      "title": "IndexContribution",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/attempt_record/v1",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "idempotency_key_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Idempotency Key Hash"
    },
    "index_contribution": {
      "$ref": "#/$defs/IndexContribution"
    },
    "ordinal": {
      "exclusiveMinimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "outcome": {
      "$ref": "#/$defs/AttemptOutcome"
    },
    "parent_id": {
      "minLength": 1,
      "title": "Parent Id",
      "type": "string"
    },
    "parent_kind": {
      "enum": [
        "ingestion_plan",
        "case",
        "phase_review"
      ],
      "title": "Parent Kind",
      "type": "string"
    },
    "raw_error_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Error Ref"
    },
    "raw_response_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Response Ref"
    },
    "reconciliation_capability": {
      "enum": [
        "none",
        "idempotency_key",
        "receipt_lookup"
      ],
      "title": "Reconciliation Capability",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "retry_of_attempt_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retry Of Attempt Id"
    },
    "schema_name": {
      "const": "attempt_record",
      "default": "attempt_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "superseded_by_attempt_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Superseded By Attempt Id"
    }
  },
  "required": [
    "attempt_id",
    "ended_at",
    "idempotency_key_hash",
    "index_contribution",
    "ordinal",
    "outcome",
    "parent_id",
    "parent_kind",
    "raw_error_ref",
    "raw_response_ref",
    "reconciliation_capability",
    "request_fingerprint",
    "retry_of_attempt_id",
    "schema_name",
    "schema_version",
    "stage",
    "started_at",
    "superseded_by_attempt_id"
  ],
  "title": "attempt_record",
  "type": "object"
}
