{
  "$defs": {
    "AttemptReceiptKind": {
      "enum": [
        "response",
        "error",
        "unknown_outcome"
      ],
      "title": "AttemptReceiptKind",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/attempt_receipt_record/v1",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "dispatch_started_at": {
      "format": "date-time",
      "title": "Dispatch Started At",
      "type": "string"
    },
    "provider_request_wall_seconds": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
      "title": "Provider Request Wall Seconds",
      "type": "string"
    },
    "raw_error_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Error Ref"
    },
    "raw_response_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Response Ref"
    },
    "receipt_kind": {
      "$ref": "#/$defs/AttemptReceiptKind"
    },
    "receipt_observed_at": {
      "format": "date-time",
      "title": "Receipt Observed At",
      "type": "string"
    },
    "schema_name": {
      "const": "attempt_receipt_record",
      "default": "attempt_receipt_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "attempt_id",
    "dispatch_started_at",
    "provider_request_wall_seconds",
    "raw_error_ref",
    "raw_response_ref",
    "receipt_kind",
    "receipt_observed_at",
    "schema_name",
    "schema_version"
  ],
  "title": "attempt_receipt_record",
  "type": "object"
}
