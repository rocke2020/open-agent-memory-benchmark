{
  "$defs": {
    "QualityReviewStatus": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "QualityReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/ai_quality_review_record/v1",
  "additionalProperties": false,
  "properties": {
    "accounting_closed": {
      "title": "Accounting Closed",
      "type": "boolean"
    },
    "aggregate_version": {
      "minLength": 1,
      "title": "Aggregate Version",
      "type": "string"
    },
    "ai_review_record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ai Review Record Id",
      "type": "string"
    },
    "attempt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Attempt Ids",
      "type": "array"
    },
    "batch_result_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Batch Result Hashes",
      "type": "array"
    },
    "case_coverage_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Coverage Hash",
      "type": "string"
    },
    "cost_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Cost Record Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "finding_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Finding Codes",
      "type": "array"
    },
    "finding_registry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Finding Registry Hash",
      "type": "string"
    },
    "history_root_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "History Root Hash",
      "type": "string"
    },
    "integrity_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Integrity Result Hash",
      "type": "string"
    },
    "occurrence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Occurrence Id",
      "type": "string"
    },
    "ordinal": {
      "exclusiveMinimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "output_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Contract Hash",
      "type": "string"
    },
    "parser_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parser Hash",
      "type": "string"
    },
    "previous_ai_review_record_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Ai Review Record Hash"
    },
    "previous_history_root_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous History Root Hash"
    },
    "projection_spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Projection Spec Hash",
      "type": "string"
    },
    "prompt_pack_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Pack Hash",
      "type": "string"
    },
    "resource_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Resource Record Ids",
      "type": "array"
    },
    "review_bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Bundle Hash",
      "type": "string"
    },
    "review_outcome_kind": {
      "enum": [
        "complete",
        "semantic_failure",
        "operational_inconclusive",
        "evidence_inconclusive"
      ],
      "title": "Review Outcome Kind",
      "type": "string"
    },
    "review_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Plan Hash",
      "type": "string"
    },
    "reviewer_configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reviewer Configuration Hash",
      "type": "string"
    },
    "reviewer_model_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reviewer Model Hash",
      "type": "string"
    },
    "reviewer_role_binding_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reviewer Role Binding Hash",
      "type": "string"
    },
    "reviewer_runtime_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reviewer Runtime Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "ai_quality_review_record",
      "default": "ai_quality_review_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/QualityReviewStatus"
    },
    "usage_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Usage Record Ids",
      "type": "array"
    }
  },
  "required": [
    "accounting_closed",
    "aggregate_version",
    "ai_review_record_id",
    "attempt_ids",
    "batch_result_hashes",
    "case_coverage_hash",
    "cost_record_ids",
    "created_at",
    "finding_codes",
    "finding_registry_hash",
    "history_root_hash",
    "integrity_result_hash",
    "occurrence_id",
    "ordinal",
    "output_contract_hash",
    "parser_hash",
    "previous_ai_review_record_hash",
    "previous_history_root_hash",
    "projection_spec_hash",
    "prompt_pack_hash",
    "resource_record_ids",
    "review_bundle_hash",
    "review_outcome_kind",
    "review_plan_hash",
    "reviewer_configuration_hash",
    "reviewer_model_hash",
    "reviewer_role_binding_hash",
    "reviewer_runtime_hash",
    "schema_name",
    "schema_version",
    "status",
    "usage_record_ids"
  ],
  "title": "ai_quality_review_record",
  "type": "object"
}
