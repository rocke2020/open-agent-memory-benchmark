{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/dataset_file/v1",
  "additionalProperties": false,
  "properties": {
    "byte_count": {
      "minimum": 0,
      "title": "Byte Count",
      "type": "integer"
    },
    "license_id": {
      "minLength": 1,
      "title": "License Id",
      "type": "string"
    },
    "relative_path": {
      "minLength": 1,
      "title": "Relative Path",
      "type": "string"
    },
    "schema_name": {
      "const": "dataset_file",
      "default": "dataset_file",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "byte_count",
    "license_id",
    "relative_path",
    "schema_name",
    "schema_version",
    "sha256"
  ],
  "title": "dataset_file",
  "type": "object"
}
