{
  "$defs": {
    "ReportIdentitySpecBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "schema_name": {
          "const": "report_identity_spec_binding",
          "default": "report_identity_spec_binding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "spec_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "spec_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Id",
          "type": "string"
        },
        "spec_kind": {
          "enum": [
            "benchmark_report",
            "acceptance_report"
          ],
          "title": "Spec Kind",
          "type": "string"
        },
        "spec_schema_name": {
          "enum": [
            "report_spec",
            "acceptance_report_spec"
          ],
          "title": "Spec Schema Name",
          "type": "string"
        },
        "spec_schema_version": {
          "const": 1,
          "default": 1,
          "title": "Spec Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "binding_id",
        "schema_name",
        "schema_version",
        "spec_hash",
        "spec_id",
        "spec_kind",
        "spec_schema_name"
      ],
      "title": "ReportIdentitySpecBinding",
      "type": "object"
    },
    "SourceEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "schema_name": {
          "const": "source_evidence_binding",
          "default": "source_evidence_binding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_identity": {
          "minLength": 1,
          "title": "Source Identity",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceEvidenceKind"
        },
        "source_root_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Root Hash",
          "type": "string"
        },
        "source_schema_versions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Schema Versions",
          "type": "array"
        },
        "validation_result_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Result Hash",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "schema_name",
        "schema_version",
        "source_identity",
        "source_kind",
        "source_root_hash",
        "source_schema_versions",
        "validation_result_hash"
      ],
      "title": "SourceEvidenceBinding",
      "type": "object"
    },
    "SourceEvidenceKind": {
      "enum": [
        "run",
        "external",
        "derivation",
        "provider_service"
      ],
      "title": "SourceEvidenceKind",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/report_artifact_manifest/v2",
  "additionalProperties": false,
  "properties": {
    "artifact_manifest_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Manifest Id",
      "type": "string"
    },
    "asset_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Asset Hashes",
      "type": "array"
    },
    "audience": {
      "enum": [
        "local",
        "public"
      ],
      "title": "Audience",
      "type": "string"
    },
    "browser_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Browser Contract Hash",
      "type": "string"
    },
    "export_profile_selector_id": {
      "minLength": 1,
      "title": "Export Profile Selector Id",
      "type": "string"
    },
    "export_profile_selector_version": {
      "exclusiveMinimum": 0,
      "title": "Export Profile Selector Version",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "ordered_evidence_validation_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Evidence Validation Hashes",
      "type": "array"
    },
    "ordered_source_bindings": {
      "items": {
        "$ref": "#/$defs/SourceEvidenceBinding"
      },
      "title": "Ordered Source Bindings",
      "type": "array"
    },
    "performance_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Performance Contract Hash",
      "type": "string"
    },
    "renderer_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Renderer Hash",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "report_identity_spec_binding": {
      "$ref": "#/$defs/ReportIdentitySpecBinding"
    },
    "report_kind": {
      "enum": [
        "run",
        "comparison",
        "release",
        "phase_acceptance"
      ],
      "title": "Report Kind",
      "type": "string"
    },
    "report_model_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Model Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "report_artifact_manifest",
      "default": "report_artifact_manifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "schema_versions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Schema Versions",
      "type": "array"
    }
  },
  "required": [
    "artifact_manifest_id",
    "asset_hashes",
    "audience",
    "browser_contract_hash",
    "export_profile_selector_id",
    "export_profile_selector_version",
    "limitations",
    "ordered_evidence_validation_hashes",
    "ordered_source_bindings",
    "performance_contract_hash",
    "renderer_hash",
    "report_id",
    "report_identity_spec_binding",
    "report_kind",
    "report_model_hash",
    "schema_name",
    "schema_version",
    "schema_versions"
  ],
  "title": "report_artifact_manifest",
  "type": "object"
}
