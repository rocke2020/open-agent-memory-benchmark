{
  "$defs": {
    "CaseEvaluationDisposition": {
      "enum": [
        "not_run",
        "deterministic_evaluated",
        "judged",
        "unjudged"
      ],
      "title": "CaseEvaluationDisposition",
      "type": "string"
    },
    "CaseState": {
      "enum": [
        "pending",
        "retrieving",
        "normalizing",
        "answering",
        "evaluating",
        "sealing",
        "completed",
        "error",
        "unsupported",
        "cancelled",
        "budget_exceeded"
      ],
      "title": "CaseState",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/case_record/v3",
  "additionalProperties": false,
  "properties": {
    "adapter_profile_id": {
      "minLength": 1,
      "title": "Adapter Profile Id",
      "type": "string"
    },
    "answer_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Answer Raw Ref"
    },
    "attempt_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Attempt Ids",
      "type": "array"
    },
    "case_manifest_entry_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Manifest Entry Id",
      "type": "string"
    },
    "case_occurrence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Occurrence Id",
      "type": "string"
    },
    "cost_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Cost Record Ids",
      "type": "array"
    },
    "error_stage": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Stage"
    },
    "evaluation_disposition": {
      "$ref": "#/$defs/CaseEvaluationDisposition"
    },
    "evaluation_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Evaluation Raw Ref"
    },
    "ingestion_occurrence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ingestion Occurrence Id",
      "type": "string"
    },
    "judge_prompt_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Judge Prompt Raw Ref"
    },
    "metric_denominator": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Metric Denominator"
    },
    "metric_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Metric Id"
    },
    "metric_numerator": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Metric Numerator"
    },
    "native_candidate_count": {
      "minimum": 0,
      "title": "Native Candidate Count",
      "type": "integer"
    },
    "native_candidate_source_unit_ids": {
      "items": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Native Candidate Source Unit Ids",
      "type": "array"
    },
    "ordered_native_candidate_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Ordered Native Candidate Ids",
      "type": "array"
    },
    "ordered_native_content_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Native Content Sha256",
      "type": "array"
    },
    "parsed_answer_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parsed Answer Sha256"
    },
    "post_query_projection_raw_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Post Query Projection Raw Refs",
      "type": "array"
    },
    "post_query_state_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Post Query State Sha256"
    },
    "pre_query_projection_raw_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Pre Query Projection Raw Refs",
      "type": "array"
    },
    "pre_query_state_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pre Query State Sha256"
    },
    "prompt_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prompt Raw Ref"
    },
    "prompt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prompt Sha256"
    },
    "query_mutation_status": {
      "enum": [
        "unchanged",
        "changed",
        "unavailable"
      ],
      "title": "Query Mutation Status",
      "type": "string"
    },
    "resource_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Resource Record Ids",
      "type": "array"
    },
    "retrieval_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retrieval Raw Ref"
    },
    "retrieval_supporting_raw_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Retrieval Supporting Raw Refs",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "case_record",
      "default": "case_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/CaseState"
    },
    "usage_record_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Usage Record Ids",
      "type": "array"
    },
    "visible_decision_ledger_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visible Decision Ledger Raw Ref"
    },
    "visible_dropped_count": {
      "minimum": 0,
      "title": "Visible Dropped Count",
      "type": "integer"
    },
    "visible_evidence_byte_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visible Evidence Byte Count"
    },
    "visible_evidence_raw_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visible Evidence Raw Ref"
    },
    "visible_evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visible Evidence Sha256"
    },
    "visible_evidence_token_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visible Evidence Token Count"
    },
    "visible_evidence_tokenizer_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visible Evidence Tokenizer Fingerprint"
    },
    "visible_kept_count": {
      "minimum": 0,
      "title": "Visible Kept Count",
      "type": "integer"
    },
    "visible_truncated_count": {
      "minimum": 0,
      "title": "Visible Truncated Count",
      "type": "integer"
    }
  },
  "required": [
    "adapter_profile_id",
    "answer_raw_ref",
    "attempt_ids",
    "case_manifest_entry_id",
    "case_occurrence_id",
    "cost_record_ids",
    "error_stage",
    "evaluation_disposition",
    "evaluation_raw_ref",
    "ingestion_occurrence_id",
    "judge_prompt_raw_ref",
    "metric_denominator",
    "metric_id",
    "metric_numerator",
    "native_candidate_count",
    "native_candidate_source_unit_ids",
    "ordered_native_candidate_ids",
    "ordered_native_content_sha256",
    "parsed_answer_sha256",
    "post_query_projection_raw_refs",
    "post_query_state_sha256",
    "pre_query_projection_raw_refs",
    "pre_query_state_sha256",
    "prompt_raw_ref",
    "prompt_sha256",
    "query_mutation_status",
    "resource_record_ids",
    "retrieval_raw_ref",
    "retrieval_supporting_raw_refs",
    "run_id",
    "schema_name",
    "schema_version",
    "state",
    "usage_record_ids",
    "visible_decision_ledger_raw_ref",
    "visible_dropped_count",
    "visible_evidence_byte_count",
    "visible_evidence_raw_ref",
    "visible_evidence_sha256",
    "visible_evidence_token_count",
    "visible_evidence_tokenizer_fingerprint",
    "visible_kept_count",
    "visible_truncated_count"
  ],
  "title": "case_record",
  "type": "object"
}
