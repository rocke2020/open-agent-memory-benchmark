{
  "$defs": {
    "ProviderGateStatus": {
      "enum": [
        "not_run",
        "pass",
        "fail",
        "unsupported"
      ],
      "title": "ProviderGateStatus",
      "type": "string"
    },
    "TransportProfile": {
      "enum": [
        "rest",
        "sdk",
        "fake"
      ],
      "title": "TransportProfile",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/provider_runtime_profile_attestation/v1",
  "additionalProperties": false,
  "properties": {
    "attestation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attestation Hash",
      "type": "string"
    },
    "auth_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Auth Configuration Sha256",
      "type": "string"
    },
    "build_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Build Artifact Sha256",
      "type": "string"
    },
    "liveness_status": {
      "$ref": "#/$defs/ProviderGateStatus"
    },
    "memory_conformance_status": {
      "$ref": "#/$defs/ProviderGateStatus"
    },
    "model_readiness_status": {
      "$ref": "#/$defs/ProviderGateStatus"
    },
    "model_role_binding_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Model Role Binding Ids",
      "type": "array"
    },
    "native_reranking_status": {
      "const": "disabled",
      "title": "Native Reranking Status",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "provider_profile_id": {
      "minLength": 1,
      "title": "Provider Profile Id",
      "type": "string"
    },
    "provider_project_id": {
      "minLength": 1,
      "title": "Provider Project Id",
      "type": "string"
    },
    "raw_proof_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Raw Proof Refs",
      "type": "array"
    },
    "redacted_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Redacted Configuration Sha256",
      "type": "string"
    },
    "redacted_endpoint_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Redacted Endpoint Fingerprint",
      "type": "string"
    },
    "release_version": {
      "minLength": 1,
      "title": "Release Version",
      "type": "string"
    },
    "runtime_identity_status": {
      "$ref": "#/$defs/ProviderGateStatus"
    },
    "schema_name": {
      "const": "provider_runtime_profile_attestation",
      "default": "provider_runtime_profile_attestation",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "storage_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Storage Configuration Sha256",
      "type": "string"
    },
    "storage_configuration_status": {
      "$ref": "#/$defs/ProviderGateStatus"
    },
    "transport_profile": {
      "$ref": "#/$defs/TransportProfile"
    }
  },
  "required": [
    "attestation_hash",
    "auth_configuration_sha256",
    "build_artifact_sha256",
    "liveness_status",
    "memory_conformance_status",
    "model_readiness_status",
    "model_role_binding_ids",
    "native_reranking_status",
    "provider",
    "provider_profile_id",
    "provider_project_id",
    "raw_proof_refs",
    "redacted_configuration_sha256",
    "redacted_endpoint_fingerprint",
    "release_version",
    "runtime_identity_status",
    "schema_name",
    "schema_version",
    "source_revision",
    "storage_configuration_sha256",
    "storage_configuration_status",
    "transport_profile"
  ],
  "title": "provider_runtime_profile_attestation",
  "type": "object"
}
