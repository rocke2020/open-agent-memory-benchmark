{
  "$defs": {
    "ExactRational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "title": "Numerator",
          "type": "integer"
        },
        "schema_name": {
          "const": "exact_rational",
          "default": "exact_rational",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "denominator",
        "numerator",
        "schema_name",
        "schema_version"
      ],
      "title": "ExactRational",
      "type": "object"
    },
    "MabCapabilityMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "ar",
            "ttl",
            "lru",
            "cr_sf"
          ],
          "title": "Capability",
          "type": "string"
        },
        "schema_name": {
          "const": "mab_capability_metric_summary",
          "default": "mab_capability_metric_summary",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "score": {
          "$ref": "#/$defs/ExactRational"
        },
        "weight": {
          "$ref": "#/$defs/ExactRational"
        },
        "weighted_contribution": {
          "$ref": "#/$defs/ExactRational"
        }
      },
      "required": [
        "capability",
        "schema_name",
        "schema_version",
        "score",
        "weight",
        "weighted_contribution"
      ],
      "title": "MabCapabilityMetricSummary",
      "type": "object"
    },
    "MabComponentMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "exclusiveMinimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "component": {
          "enum": [
            "ar",
            "icl",
            "recsys",
            "lru",
            "cr_sf"
          ],
          "title": "Component",
          "type": "string"
        },
        "plan_count": {
          "exclusiveMinimum": 0,
          "title": "Plan Count",
          "type": "integer"
        },
        "schema_name": {
          "const": "mab_component_metric_summary",
          "default": "mab_component_metric_summary",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "score": {
          "$ref": "#/$defs/ExactRational"
        }
      },
      "required": [
        "case_count",
        "component",
        "plan_count",
        "schema_name",
        "schema_version",
        "score"
      ],
      "title": "MabComponentMetricSummary",
      "type": "object"
    },
    "MabPlanEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "ingestion_occurrence_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ingestion Occurrence Id",
          "type": "string"
        },
        "ingestion_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ingestion Plan Id",
          "type": "string"
        },
        "member_labels": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Member Labels",
          "type": "array"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "ordered_case_occurrence_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Ordered Case Occurrence Ids",
          "type": "array"
        },
        "ordered_logical_context_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Ordered Logical Context Ids",
          "type": "array"
        },
        "plan_manifest_entry_id": {
          "minLength": 1,
          "title": "Plan Manifest Entry Id",
          "type": "string"
        },
        "resolution_evidence_references": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Resolution Evidence References",
          "type": "array"
        },
        "schema_name": {
          "const": "mab_plan_evidence_binding",
          "default": "mab_plan_evidence_binding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "ingestion_occurrence_id",
        "ingestion_plan_id",
        "member_labels",
        "metric_id",
        "ordered_case_occurrence_ids",
        "ordered_logical_context_ids",
        "plan_manifest_entry_id",
        "resolution_evidence_references",
        "schema_name",
        "schema_version"
      ],
      "title": "MabPlanEvidenceBinding",
      "type": "object"
    },
    "MabPlanMetricSummary": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "exclusiveMinimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "component": {
          "enum": [
            "ar",
            "icl",
            "recsys",
            "lru",
            "cr_sf"
          ],
          "title": "Component",
          "type": "string"
        },
        "evidence_binding": {
          "$ref": "#/$defs/MabPlanEvidenceBinding"
        },
        "plan_manifest_entry_id": {
          "minLength": 1,
          "title": "Plan Manifest Entry Id",
          "type": "string"
        },
        "schema_name": {
          "const": "mab_plan_metric_summary",
          "default": "mab_plan_metric_summary",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "score": {
          "$ref": "#/$defs/ExactRational"
        }
      },
      "required": [
        "case_count",
        "component",
        "evidence_binding",
        "plan_manifest_entry_id",
        "schema_name",
        "schema_version",
        "score"
      ],
      "title": "MabPlanMetricSummary",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/mab65_report_reduction/v1",
  "additionalProperties": false,
  "properties": {
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/MabCapabilityMetricSummary"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/MabComponentMetricSummary"
      },
      "title": "Components",
      "type": "array"
    },
    "index_value": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRational"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/MabPlanMetricSummary"
      },
      "title": "Plans",
      "type": "array"
    },
    "reducer_id": {
      "const": "mab65-capability-balanced-index-v1",
      "title": "Reducer Id",
      "type": "string"
    },
    "schema_name": {
      "const": "mab65_report_reduction",
      "default": "mab65_report_reduction",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "ttl_score": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRational"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unavailable Reason"
    }
  },
  "required": [
    "available",
    "capabilities",
    "components",
    "plans",
    "reducer_id",
    "schema_name",
    "schema_version"
  ],
  "title": "mab65_report_reduction",
  "type": "object"
}
