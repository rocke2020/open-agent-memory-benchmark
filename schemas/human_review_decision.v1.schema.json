{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/human_review_decision/v1",
  "additionalProperties": false,
  "properties": {
    "ai_review_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ai Review Record Hash",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Id",
      "type": "string"
    },
    "evidence_references": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "finding_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Finding Codes",
      "type": "array"
    },
    "nonce": {
      "minLength": 1,
      "title": "Nonce",
      "type": "string"
    },
    "review_bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Bundle Hash",
      "type": "string"
    },
    "reviewer_label": {
      "minLength": 1,
      "title": "Reviewer Label",
      "type": "string"
    },
    "schema_name": {
      "const": "human_review_decision",
      "default": "human_review_decision",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "ai_review_record_hash",
    "decided_at",
    "decision_id",
    "evidence_references",
    "finding_codes",
    "nonce",
    "review_bundle_hash",
    "reviewer_label",
    "schema_name",
    "schema_version",
    "status"
  ],
  "title": "human_review_decision",
  "type": "object"
}
