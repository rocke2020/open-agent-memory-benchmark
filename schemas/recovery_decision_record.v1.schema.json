{
  "$defs": {
    "RecoveryDisposition": {
      "enum": [
        "resume_safe",
        "replacement_run_required",
        "terminal_unknown_outcome"
      ],
      "title": "RecoveryDisposition",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/recovery_decision_record/v1",
  "additionalProperties": false,
  "properties": {
    "archived_checkpoint_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Archived Checkpoint Hashes",
      "type": "array"
    },
    "authorization_id": {
      "minLength": 1,
      "title": "Authorization Id",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/RecoveryDisposition"
    },
    "new_lease_epoch": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "New Lease Epoch"
    },
    "new_lease_record_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "New Lease Record Hash"
    },
    "previous_lease_epoch": {
      "exclusiveMinimum": 0,
      "title": "Previous Lease Epoch",
      "type": "integer"
    },
    "previous_lease_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Lease Record Hash",
      "type": "string"
    },
    "recovery_decision_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recovery Decision Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "recovery_decision_record",
      "default": "recovery_decision_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "archived_checkpoint_hashes",
    "authorization_id",
    "decided_at",
    "disposition",
    "new_lease_epoch",
    "new_lease_record_hash",
    "previous_lease_epoch",
    "previous_lease_record_hash",
    "recovery_decision_id",
    "run_id",
    "schema_name",
    "schema_version"
  ],
  "title": "recovery_decision_record",
  "type": "object"
}
