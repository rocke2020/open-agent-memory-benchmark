{
  "$defs": {
    "DisplayPreview": {
      "additionalProperties": false,
      "properties": {
        "limitation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Limitation"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_name": {
          "const": "display_preview",
          "default": "display_preview",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shown_bytes": {
          "minimum": 0,
          "title": "Shown Bytes",
          "type": "integer"
        },
        "source_reference": {
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "total_bytes": {
          "minimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "limitation",
        "media_type",
        "schema_name",
        "schema_version",
        "sha256",
        "shown_bytes",
        "source_reference",
        "text",
        "total_bytes",
        "truncated"
      ],
      "title": "DisplayPreview",
      "type": "object"
    },
    "ProofStatus": {
      "enum": [
        "measured_complete",
        "measured_partial",
        "unavailable",
        "not_applicable"
      ],
      "title": "ProofStatus",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/report_record_projection/v1",
  "additionalProperties": false,
  "properties": {
    "axis": {
      "enum": [
        "logical-context",
        "plan",
        "case",
        "attempt"
      ],
      "title": "Axis",
      "type": "string"
    },
    "capabilities_or_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Capabilities Or Types",
      "type": "array"
    },
    "context_view_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context View Tokens"
    },
    "declared_usage": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Usage"
    },
    "detail_items": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Detail Items",
      "type": "array"
    },
    "display_previews": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DisplayPreview"
      },
      "title": "Display Previews",
      "type": "array"
    },
    "evaluation_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Status"
    },
    "failure_stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Stage"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "latency_microseconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Microseconds"
    },
    "metric_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Metric Ids",
      "type": "array"
    },
    "proof_statuses": {
      "items": {
        "$ref": "#/$defs/ProofStatus"
      },
      "title": "Proof Statuses",
      "type": "array"
    },
    "raw_evidence_present": {
      "title": "Raw Evidence Present",
      "type": "boolean"
    },
    "record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Id",
      "type": "string"
    },
    "schema_name": {
      "const": "report_record_projection",
      "default": "report_record_projection",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "verdict": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict"
    }
  },
  "required": [
    "axis",
    "capabilities_or_types",
    "detail_items",
    "label",
    "metric_ids",
    "proof_statuses",
    "raw_evidence_present",
    "record_id",
    "schema_name",
    "schema_version",
    "status"
  ],
  "title": "report_record_projection",
  "type": "object"
}
