{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/comparison_winner_reducer/v1",
  "additionalProperties": false,
  "properties": {
    "aggregate_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Aggregate Contract Hash",
      "type": "string"
    },
    "denominator": {
      "exclusiveMinimum": 0,
      "title": "Denominator",
      "type": "integer"
    },
    "metric_id": {
      "minLength": 1,
      "title": "Metric Id",
      "type": "string"
    },
    "reducer_id": {
      "minLength": 1,
      "title": "Reducer Id",
      "type": "string"
    },
    "reducer_version": {
      "exclusiveMinimum": 0,
      "title": "Reducer Version",
      "type": "integer"
    },
    "schema_name": {
      "const": "comparison_winner_reducer",
      "default": "comparison_winner_reducer",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "aggregate_contract_hash",
    "denominator",
    "metric_id",
    "reducer_id",
    "reducer_version",
    "schema_name",
    "schema_version"
  ],
  "title": "comparison_winner_reducer",
  "type": "object"
}
