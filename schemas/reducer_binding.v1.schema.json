{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/reducer_binding/v1",
  "additionalProperties": false,
  "properties": {
    "implementation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Hash",
      "type": "string"
    },
    "reducer_id": {
      "minLength": 1,
      "title": "Reducer Id",
      "type": "string"
    },
    "reducer_version": {
      "exclusiveMinimum": 0,
      "title": "Reducer Version",
      "type": "integer"
    },
    "schema_name": {
      "const": "reducer_binding",
      "default": "reducer_binding",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "implementation_hash",
    "reducer_id",
    "reducer_version",
    "schema_name",
    "schema_version"
  ],
  "title": "reducer_binding",
  "type": "object"
}
