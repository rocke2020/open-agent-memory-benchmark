{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/acceptance_report_spec/v1",
  "additionalProperties": false,
  "properties": {
    "acceptance_report_spec_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Acceptance Report Spec Id",
      "type": "string"
    },
    "ai_review_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ai Review Record Hash",
      "type": "string"
    },
    "asset_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Asset Hashes",
      "type": "array"
    },
    "audience": {
      "enum": [
        "local",
        "public"
      ],
      "title": "Audience",
      "type": "string"
    },
    "browser_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Browser Contract Hash",
      "type": "string"
    },
    "evaluation_export_validation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Export Validation Hash",
      "type": "string"
    },
    "evaluation_report_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Report Hash",
      "type": "string"
    },
    "export_profile_selector_id": {
      "minLength": 1,
      "title": "Export Profile Selector Id",
      "type": "string"
    },
    "export_profile_selector_version": {
      "exclusiveMinimum": 0,
      "title": "Export Profile Selector Version",
      "type": "integer"
    },
    "human_review_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Human Review Record Hash",
      "type": "string"
    },
    "performance_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Performance Contract Hash",
      "type": "string"
    },
    "phase_gate_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Phase Gate Hash",
      "type": "string"
    },
    "renderer_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Renderer Hash",
      "type": "string"
    },
    "review_bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Bundle Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "acceptance_report_spec",
      "default": "acceptance_report_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "acceptance_report_spec_id",
    "ai_review_record_hash",
    "asset_hashes",
    "audience",
    "browser_contract_hash",
    "evaluation_export_validation_hash",
    "evaluation_report_hash",
    "export_profile_selector_id",
    "export_profile_selector_version",
    "human_review_record_hash",
    "performance_contract_hash",
    "phase_gate_hash",
    "renderer_hash",
    "review_bundle_hash",
    "schema_name",
    "schema_version"
  ],
  "title": "acceptance_report_spec",
  "type": "object"
}
