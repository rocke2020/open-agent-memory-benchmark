{
  "$defs": {
    "ComparisonCostView": {
      "enum": [
        "none",
        "raw_resource",
        "actual_charge",
        "declared_rate_estimate"
      ],
      "title": "ComparisonCostView",
      "type": "string"
    },
    "ExactRational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "title": "Numerator",
          "type": "integer"
        },
        "schema_name": {
          "const": "exact_rational",
          "default": "exact_rational",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "denominator",
        "numerator",
        "schema_name",
        "schema_version"
      ],
      "title": "ExactRational",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/comparison_cost_delta/v1",
  "additionalProperties": false,
  "properties": {
    "absolute_delta": {
      "$ref": "#/$defs/ExactRational"
    },
    "basis": {
      "enum": [
        "raw_resource",
        "actual_supplier_charge",
        "estimate_from_measured_usage"
      ],
      "title": "Basis",
      "type": "string"
    },
    "cost_control_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cost Control Hash",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Currency"
    },
    "dimension_id": {
      "minLength": 1,
      "title": "Dimension Id",
      "type": "string"
    },
    "left": {
      "$ref": "#/$defs/ExactRational"
    },
    "right": {
      "$ref": "#/$defs/ExactRational"
    },
    "schema_name": {
      "const": "comparison_cost_delta",
      "default": "comparison_cost_delta",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "signed_delta": {
      "$ref": "#/$defs/ExactRational"
    },
    "unit": {
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    },
    "view": {
      "$ref": "#/$defs/ComparisonCostView"
    }
  },
  "required": [
    "absolute_delta",
    "basis",
    "cost_control_hash",
    "currency",
    "dimension_id",
    "left",
    "right",
    "schema_name",
    "schema_version",
    "signed_delta",
    "unit",
    "view"
  ],
  "title": "comparison_cost_delta",
  "type": "object"
}
