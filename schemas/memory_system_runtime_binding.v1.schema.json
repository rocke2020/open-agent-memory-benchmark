{
  "$defs": {
    "AttestationStatus": {
      "enum": [
        "attested",
        "unattested",
        "unsupported"
      ],
      "title": "AttestationStatus",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/memory_system_runtime_binding/v1",
  "additionalProperties": false,
  "properties": {
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "attestation_status": {
      "$ref": "#/$defs/AttestationStatus"
    },
    "memory_system_id": {
      "minLength": 1,
      "title": "Memory System Id",
      "type": "string"
    },
    "model_role_binding_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Model Role Binding Ids",
      "type": "array"
    },
    "release_version": {
      "minLength": 1,
      "title": "Release Version",
      "type": "string"
    },
    "runtime_binding_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Binding Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "memory_system_runtime_binding",
      "default": "memory_system_runtime_binding",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "storage_engine": {
      "minLength": 1,
      "title": "Storage Engine",
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "attestation_status",
    "memory_system_id",
    "model_role_binding_ids",
    "release_version",
    "runtime_binding_hash",
    "schema_name",
    "schema_version",
    "storage_engine"
  ],
  "title": "memory_system_runtime_binding",
  "type": "object"
}
