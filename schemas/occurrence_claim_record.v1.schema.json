{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/occurrence_claim_record/v1",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Claim Id",
      "type": "string"
    },
    "claimed_at": {
      "format": "date-time",
      "title": "Claimed At",
      "type": "string"
    },
    "lease_epoch": {
      "exclusiveMinimum": 0,
      "title": "Lease Epoch",
      "type": "integer"
    },
    "lease_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Lease Record Hash",
      "type": "string"
    },
    "occurrence_id": {
      "minLength": 1,
      "title": "Occurrence Id",
      "type": "string"
    },
    "owner_id": {
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "reconciliation_capability": {
      "enum": [
        "none",
        "idempotency_key",
        "receipt_lookup"
      ],
      "title": "Reconciliation Capability",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "schema_name": {
      "const": "occurrence_claim_record",
      "default": "occurrence_claim_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "claimed_at",
    "lease_epoch",
    "lease_record_hash",
    "occurrence_id",
    "owner_id",
    "reconciliation_capability",
    "request_fingerprint",
    "schema_name",
    "schema_version",
    "stage"
  ],
  "title": "occurrence_claim_record",
  "type": "object"
}
