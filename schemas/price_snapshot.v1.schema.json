{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/price_snapshot/v1",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "price_class_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Price Class Ids",
      "type": "array"
    },
    "price_snapshot_id": {
      "minLength": 1,
      "title": "Price Snapshot Id",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "schema_name": {
      "const": "price_snapshot",
      "default": "price_snapshot",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "unit_prices": {
      "items": {
        "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
        "type": "string"
      },
      "title": "Unit Prices",
      "type": "array"
    }
  },
  "required": [
    "currency",
    "effective_at",
    "price_class_ids",
    "price_snapshot_id",
    "provider",
    "schema_name",
    "schema_version",
    "unit_prices"
  ],
  "title": "price_snapshot",
  "type": "object"
}
