{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/workload_spec/v1",
  "additionalProperties": false,
  "properties": {
    "case_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Manifest Hash",
      "type": "string"
    },
    "dataset_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Manifest Hash",
      "type": "string"
    },
    "interaction_spec_id": {
      "minLength": 1,
      "title": "Interaction Spec Id",
      "type": "string"
    },
    "metric_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Metric Ids",
      "type": "array"
    },
    "prompt_pack_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Prompt Pack Ids",
      "type": "array"
    },
    "schema_name": {
      "const": "workload_spec",
      "default": "workload_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workload_id": {
      "minLength": 1,
      "title": "Workload Id",
      "type": "string"
    },
    "workload_version": {
      "minLength": 1,
      "title": "Workload Version",
      "type": "string"
    }
  },
  "required": [
    "case_manifest_hash",
    "dataset_manifest_hash",
    "interaction_spec_id",
    "metric_ids",
    "prompt_pack_ids",
    "schema_name",
    "schema_version",
    "workload_id",
    "workload_version"
  ],
  "title": "workload_spec",
  "type": "object"
}
