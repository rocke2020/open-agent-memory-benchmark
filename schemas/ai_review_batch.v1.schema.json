{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/ai_review_batch/v1",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Id",
      "type": "string"
    },
    "input_bytes": {
      "exclusiveMinimum": 0,
      "title": "Input Bytes",
      "type": "integer"
    },
    "input_tokens": {
      "exclusiveMinimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "maximal_output_bytes": {
      "exclusiveMinimum": 0,
      "title": "Maximal Output Bytes",
      "type": "integer"
    },
    "maximal_output_tokens": {
      "exclusiveMinimum": 0,
      "title": "Maximal Output Tokens",
      "type": "integer"
    },
    "ordered_case_occurrence_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Case Occurrence Ids",
      "type": "array"
    },
    "payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "schema_name": {
      "const": "ai_review_batch",
      "default": "ai_review_batch",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "batch_id",
    "input_bytes",
    "input_tokens",
    "maximal_output_bytes",
    "maximal_output_tokens",
    "ordered_case_occurrence_ids",
    "payload_hash",
    "request_fingerprint",
    "schema_name",
    "schema_version"
  ],
  "title": "ai_review_batch",
  "type": "object"
}
