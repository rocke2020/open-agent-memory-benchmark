{
  "$defs": {
    "ValidationRuleRequirement": {
      "additionalProperties": false,
      "properties": {
        "minimum_version": {
          "exclusiveMinimum": 0,
          "title": "Minimum Version",
          "type": "integer"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "schema_name": {
          "const": "validation_rule_requirement",
          "default": "validation_rule_requirement",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "minimum_version",
        "rule_id",
        "schema_name",
        "schema_version"
      ],
      "title": "ValidationRuleRequirement",
      "type": "object"
    },
    "ValidationStage": {
      "enum": [
        "evidence",
        "export"
      ],
      "title": "ValidationStage",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/validation_profile/v1",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Applicability",
      "type": "array"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "required_rule_inventory_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Required Rule Inventory Hash",
      "type": "string"
    },
    "required_rules": {
      "items": {
        "$ref": "#/$defs/ValidationRuleRequirement"
      },
      "title": "Required Rules",
      "type": "array"
    },
    "schema_name": {
      "const": "validation_profile",
      "default": "validation_profile",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/ValidationStage"
    }
  },
  "required": [
    "applicability",
    "profile_id",
    "required_rule_inventory_hash",
    "required_rules",
    "schema_name",
    "schema_version",
    "stage"
  ],
  "title": "validation_profile",
  "type": "object"
}
