{
  "$defs": {
    "RunSummary": {
      "additionalProperties": false,
      "properties": {
        "billing_complete": {
          "title": "Billing Complete",
          "type": "boolean"
        },
        "budget_exceeded_cases": {
          "minimum": 0,
          "title": "Budget Exceeded Cases",
          "type": "integer"
        },
        "cancelled_cases": {
          "minimum": 0,
          "title": "Cancelled Cases",
          "type": "integer"
        },
        "completed_cases": {
          "minimum": 0,
          "title": "Completed Cases",
          "type": "integer"
        },
        "cost_complete": {
          "title": "Cost Complete",
          "type": "boolean"
        },
        "errored_cases": {
          "minimum": 0,
          "title": "Errored Cases",
          "type": "integer"
        },
        "intended_cases": {
          "minimum": 0,
          "title": "Intended Cases",
          "type": "integer"
        },
        "intended_ingestion_plans": {
          "minimum": 0,
          "title": "Intended Ingestion Plans",
          "type": "integer"
        },
        "intended_logical_contexts": {
          "minimum": 0,
          "title": "Intended Logical Contexts",
          "type": "integer"
        },
        "ready_ingestion_plans": {
          "minimum": 0,
          "title": "Ready Ingestion Plans",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_name": {
          "const": "run_summary",
          "default": "run_summary",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "terminal_cases": {
          "minimum": 0,
          "title": "Terminal Cases",
          "type": "integer"
        },
        "unsupported_cases": {
          "minimum": 0,
          "title": "Unsupported Cases",
          "type": "integer"
        }
      },
      "required": [
        "billing_complete",
        "budget_exceeded_cases",
        "cancelled_cases",
        "completed_cases",
        "cost_complete",
        "errored_cases",
        "intended_cases",
        "intended_ingestion_plans",
        "intended_logical_contexts",
        "ready_ingestion_plans",
        "run_id",
        "schema_name",
        "schema_version",
        "terminal_cases",
        "unsupported_cases"
      ],
      "title": "RunSummary",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/run_report_model/v1",
  "additionalProperties": false,
  "properties": {
    "evidence_validation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Validation Hash",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_name": {
      "const": "run_report_model",
      "default": "run_report_model",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Hash",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/RunSummary"
    }
  },
  "required": [
    "evidence_validation_hash",
    "limitations",
    "report_id",
    "schema_name",
    "schema_version",
    "source_manifest_hash",
    "summary"
  ],
  "title": "run_report_model",
  "type": "object"
}
