{
  "$defs": {
    "TransportProfile": {
      "enum": [
        "rest",
        "sdk",
        "fake"
      ],
      "title": "TransportProfile",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/memory_system_spec/v1",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "minLength": 1,
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_revision": {
      "minLength": 1,
      "title": "Adapter Revision",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "memory_system_id": {
      "minLength": 1,
      "title": "Memory System Id",
      "type": "string"
    },
    "native_configuration_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Native Configuration Fingerprint",
      "type": "string"
    },
    "schema_name": {
      "const": "memory_system_spec",
      "default": "memory_system_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "transport_profile": {
      "$ref": "#/$defs/TransportProfile"
    }
  },
  "required": [
    "adapter_id",
    "adapter_revision",
    "capabilities",
    "memory_system_id",
    "native_configuration_fingerprint",
    "schema_name",
    "schema_version",
    "transport_profile"
  ],
  "title": "memory_system_spec",
  "type": "object"
}
