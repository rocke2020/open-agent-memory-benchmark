{
  "$defs": {
    "SourceEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "schema_name": {
          "const": "source_evidence_binding",
          "default": "source_evidence_binding",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_identity": {
          "minLength": 1,
          "title": "Source Identity",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceEvidenceKind"
        },
        "source_root_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Root Hash",
          "type": "string"
        },
        "source_schema_versions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Schema Versions",
          "type": "array"
        },
        "validation_result_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Result Hash",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "schema_name",
        "schema_version",
        "source_identity",
        "source_kind",
        "source_root_hash",
        "source_schema_versions",
        "validation_result_hash"
      ],
      "title": "SourceEvidenceBinding",
      "type": "object"
    },
    "SourceEvidenceKind": {
      "enum": [
        "run",
        "external",
        "derivation",
        "provider_service"
      ],
      "title": "SourceEvidenceKind",
      "type": "string"
    },
    "ValidationClaimBoundary": {
      "additionalProperties": false,
      "properties": {
        "applicable_rule_count": {
          "minimum": 0,
          "title": "Applicable Rule Count",
          "type": "integer"
        },
        "billing_complete": {
          "title": "Billing Complete",
          "type": "boolean"
        },
        "comparison_eligible": {
          "title": "Comparison Eligible",
          "type": "boolean"
        },
        "cost_complete": {
          "title": "Cost Complete",
          "type": "boolean"
        },
        "executed_rule_count": {
          "minimum": 0,
          "title": "Executed Rule Count",
          "type": "integer"
        },
        "failed_rule_count": {
          "minimum": 0,
          "title": "Failed Rule Count",
          "type": "integer"
        },
        "missing_rule_count": {
          "minimum": 0,
          "title": "Missing Rule Count",
          "type": "integer"
        },
        "not_applicable_rule_count": {
          "minimum": 0,
          "title": "Not Applicable Rule Count",
          "type": "integer"
        },
        "passed_rule_count": {
          "minimum": 0,
          "title": "Passed Rule Count",
          "type": "integer"
        },
        "schema_name": {
          "const": "validation_claim_boundary",
          "default": "validation_claim_boundary",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "pass",
            "diagnostic"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "applicable_rule_count",
        "billing_complete",
        "comparison_eligible",
        "cost_complete",
        "executed_rule_count",
        "failed_rule_count",
        "missing_rule_count",
        "not_applicable_rule_count",
        "passed_rule_count",
        "schema_name",
        "schema_version",
        "status"
      ],
      "title": "ValidationClaimBoundary",
      "type": "object"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/release_report_model/v1",
  "additionalProperties": false,
  "properties": {
    "claim_boundary": {
      "$ref": "#/$defs/ValidationClaimBoundary"
    },
    "comparison_report_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Comparison Report Hashes",
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "ordered_evidence_validation_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Evidence Validation Hashes",
      "type": "array"
    },
    "ordered_source_bindings": {
      "items": {
        "$ref": "#/$defs/SourceEvidenceBinding"
      },
      "title": "Ordered Source Bindings",
      "type": "array"
    },
    "report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "report_spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Spec Hash",
      "type": "string"
    },
    "run_report_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Run Report Hashes",
      "type": "array"
    },
    "schema_name": {
      "const": "release_report_model",
      "default": "release_report_model",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "claim_boundary",
    "comparison_report_hashes",
    "limitations",
    "ordered_evidence_validation_hashes",
    "ordered_source_bindings",
    "report_id",
    "report_spec_hash",
    "run_report_hashes",
    "schema_name",
    "schema_version"
  ],
  "title": "release_report_model",
  "type": "object"
}
