{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/close_error_record/v1",
  "additionalProperties": false,
  "properties": {
    "client_profile_id": {
      "minLength": 1,
      "title": "Client Profile Id",
      "type": "string"
    },
    "close_error_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Close Error Id",
      "type": "string"
    },
    "error_ref": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Error Ref",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "owner_id": {
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "owner_kind": {
      "enum": [
        "run",
        "phase_review",
        "model_readiness",
        "worker"
      ],
      "title": "Owner Kind",
      "type": "string"
    },
    "schema_name": {
      "const": "close_error_record",
      "default": "close_error_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shutdown_stage": {
      "minLength": 1,
      "title": "Shutdown Stage",
      "type": "string"
    }
  },
  "required": [
    "client_profile_id",
    "close_error_id",
    "error_ref",
    "occurred_at",
    "owner_id",
    "owner_kind",
    "schema_name",
    "schema_version",
    "shutdown_stage"
  ],
  "title": "close_error_record",
  "type": "object"
}
