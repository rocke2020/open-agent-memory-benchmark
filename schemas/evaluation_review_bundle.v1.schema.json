{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/evaluation_review_bundle/v1",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "export_validation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Export Validation Hash",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "ordered_capsule_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Capsule Hashes",
      "type": "array"
    },
    "ordered_case_occurrence_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Case Occurrence Ids",
      "type": "array"
    },
    "ordered_review_input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ordered Review Input Hash",
      "type": "string"
    },
    "ordered_validation_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Validation Hashes",
      "type": "array"
    },
    "ordinary_derivation_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordinary Derivation Hashes",
      "type": "array"
    },
    "phase_id": {
      "minLength": 1,
      "title": "Phase Id",
      "type": "string"
    },
    "report_html_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Html Hash",
      "type": "string"
    },
    "report_model_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Model Hash",
      "type": "string"
    },
    "schema_name": {
      "const": "evaluation_review_bundle",
      "default": "evaluation_review_bundle",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "unique_case_manifest_entry_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Unique Case Manifest Entry Ids",
      "type": "array"
    }
  },
  "required": [
    "bundle_id",
    "export_validation_hash",
    "limitations",
    "ordered_capsule_hashes",
    "ordered_case_occurrence_ids",
    "ordered_review_input_hash",
    "ordered_validation_hashes",
    "ordinary_derivation_hashes",
    "phase_id",
    "report_html_hash",
    "report_model_hash",
    "schema_name",
    "schema_version",
    "unique_case_manifest_entry_ids"
  ],
  "title": "evaluation_review_bundle",
  "type": "object"
}
