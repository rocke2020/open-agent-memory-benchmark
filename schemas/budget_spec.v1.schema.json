{
  "$defs": {
    "BudgetScopeKind": {
      "enum": [
        "run",
        "phase_review"
      ],
      "title": "BudgetScopeKind",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/budget_spec/v1",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approval Id"
    },
    "budget_id": {
      "minLength": 1,
      "title": "Budget Id",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Currency"
    },
    "max_attempts": {
      "minimum": 0,
      "title": "Max Attempts",
      "type": "integer"
    },
    "max_cost": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Cost"
    },
    "max_input_tokens": {
      "minimum": 0,
      "title": "Max Input Tokens",
      "type": "integer"
    },
    "max_output_tokens": {
      "minimum": 0,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "max_wall_seconds": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
      "title": "Max Wall Seconds",
      "type": "string"
    },
    "schema_name": {
      "const": "budget_spec",
      "default": "budget_spec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "minLength": 1,
      "title": "Scope Id",
      "type": "string"
    },
    "scope_kind": {
      "$ref": "#/$defs/BudgetScopeKind"
    }
  },
  "required": [
    "approval_id",
    "budget_id",
    "currency",
    "max_attempts",
    "max_cost",
    "max_input_tokens",
    "max_output_tokens",
    "max_wall_seconds",
    "schema_name",
    "schema_version",
    "scope_id",
    "scope_kind"
  ],
  "title": "budget_spec",
  "type": "object"
}
