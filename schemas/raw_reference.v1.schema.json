{
  "$id": "https://open-agent-memory-benchmark.dev/schemas/raw_reference/v1",
  "additionalProperties": false,
  "properties": {
    "byte_count": {
      "minimum": 0,
      "title": "Byte Count",
      "type": "integer"
    },
    "compression": {
      "enum": [
        "none",
        "gzip"
      ],
      "title": "Compression",
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "schema_name": {
      "const": "raw_reference",
      "default": "raw_reference",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "byte_count",
    "compression",
    "media_type",
    "schema_name",
    "schema_version",
    "sha256"
  ],
  "title": "raw_reference",
  "type": "object"
}
