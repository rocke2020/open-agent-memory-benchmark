{
  "$defs": {
    "OriginClass": {
      "enum": [
        "oamb_native",
        "external_amb_generated",
        "imported_third_party"
      ],
      "title": "OriginClass",
      "type": "string"
    }
  },
  "$id": "https://open-agent-memory-benchmark.dev/schemas/origin_record/v1",
  "additionalProperties": false,
  "properties": {
    "license_id": {
      "minLength": 1,
      "title": "License Id",
      "type": "string"
    },
    "origin_class": {
      "$ref": "#/$defs/OriginClass"
    },
    "origin_id": {
      "minLength": 1,
      "title": "Origin Id",
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "schema_name": {
      "const": "origin_record",
      "default": "origin_record",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "license_id",
    "origin_class",
    "origin_id",
    "producer",
    "schema_name",
    "schema_version",
    "source_sha256"
  ],
  "title": "origin_record",
  "type": "object"
}
