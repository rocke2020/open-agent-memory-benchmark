# Copy to .env, keep mode 0600, and replace every change-me value.
OAMB_PROVIDER_PROJECT=oamb-providers-20260827-local1
OAMB_MEM0_SOURCE_CHECKOUT=/absolute/path/to/mem0

OAMB_HINDSIGHT_PORT=18888
OAMB_MEM0_PORT=18889
OAMB_MEM0_INSPECTOR_PORT=16333
OAMB_OPENVIKING_PORT=19330

OAMB_EMBEDDING_BASE_URL=http://host.docker.internal:18000/v1
OAMB_EMBEDDING_MODEL=qwen3-embedding:0.6b

OAMB_HINDSIGHT_LLM_PROVIDER=openai
OAMB_HINDSIGHT_LLM_MODEL=deepseek-v4-flash
OAMB_HINDSIGHT_LLM_BASE_URL=change-me
OAMB_HINDSIGHT_LLM_API_KEY=change-me

OAMB_MEM0_LLM_MODEL=deepseek-v4-flash
OAMB_MEM0_LLM_BASE_URL=change-me
OAMB_MEM0_LLM_API_KEY=change-me
OAMB_MEM0_ADMIN_API_KEY=change-me-at-least-32-characters
OAMB_MEM0_JWT_SECRET=change-me-at-least-48-characters
OAMB_MEM0_POSTGRES_PASSWORD=change-me
OAMB_MEM0_QDRANT_API_KEY=change-me-at-least-32-characters
OAMB_MEM0_INSPECTOR_API_KEY=change-me-at-least-32-characters

OAMB_OPENVIKING_VLM_PROVIDER=openai
OAMB_OPENVIKING_VLM_MODEL=deepseek-v4-flash
OAMB_OPENVIKING_VLM_BASE_URL=change-me
OAMB_OPENVIKING_VLM_API_KEY=change-me
OAMB_OPENVIKING_ROOT_API_KEY=change-me-at-least-32-characters
OAMB_OPENVIKING_ACCOUNT_ID=oamb-benchmark
OAMB_OPENVIKING_ADMIN_USER_ID=oamb-admin
